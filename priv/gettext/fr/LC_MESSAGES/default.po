#: lib/storyteller_web/live/campaign_live/new.html.heex:475
#, elixir-autogen, elixir-format
msgid "Active duty (GM only, optional)"
msgstr "Tâche active (maître du jeu uniquement, facultative)"

#: lib/storyteller_web/live/campaign_live/new.html.heex:487
#, elixir-autogen, elixir-format
msgid "An active duty keeps this character at their starting place until you release or change it in Campaign care. A starting place is required."
msgstr "Tant qu’elle est définie, cette personne reste à son lieu de départ jusqu’à ce que vous la libériez ou la changiez dans la gestion de campagne. Un lieu de départ est requis."

#: lib/storyteller_web/live/campaign_live/edit.ex:116
#, elixir-autogen, elixir-format
msgid "An active duty needs a name up to 160 characters and a character with a known current place."
msgstr "Une tâche active nécessite un nom de 160 caractères maximum et un personnage dont le lieu actuel est connu."

#: lib/storyteller_web/live/campaign_live/new.ex:328
#, elixir-autogen, elixir-format
msgid "GM character %{number} active duty must be 160 characters or fewer."
msgstr "La tâche active du personnage %{number} du maître du jeu ne doit pas dépasser 160 caractères."

#: lib/storyteller_web/live/campaign_live/new.ex:333
#, elixir-autogen, elixir-format
msgid "GM character %{number} needs a starting place for an active duty."
msgstr "Le personnage %{number} du maître du jeu doit avoir un lieu de départ pour une tâche active."

#: lib/storyteller_web/live/campaign_live/new.html.heex:480
#, elixir-autogen, elixir-format
msgid "Tending the cellar"
msgstr "Surveiller les cuves"

#: lib/storyteller_web/live/campaign_live/edit.ex:127
