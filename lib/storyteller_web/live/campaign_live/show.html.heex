<section class="space-y-8">
  <div>
    <.link navigate={~p"/"} class="text-sm font-medium text-amber-800 hover:text-amber-950">← {gettext(
      "Campaigns"
    )}</.link>
    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-semibold tracking-tight text-stone-950">{@campaign.title}</h1>
          <span class={[
            "rounded-full px-2.5 py-1 text-xs font-semibold",
            @campaign.status == :active && "bg-emerald-50 text-emerald-800",
            @campaign.status == :archived && "bg-stone-100 text-stone-600"
          ]}>{if @campaign.status == :active, do: gettext("Active"), else: gettext("Archived")}</span>
        </div>
        <p class="mt-2 text-stone-600">
          {@campaign.setting} · {@campaign.tone} · {gettext("Narration in %{language}",
            language: @campaign.narration_language
          )}
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <.link
          navigate={~p"/campaigns/#{@campaign.id}/edit"}
          class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-700 hover:bg-white"
        >{gettext("Edit campaign")}</.link>
        <button
          :if={@campaign.status == :active}
          type="button"
          phx-click="archive"
          class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-700 hover:bg-white"
        >{gettext("Archive campaign")}</button>
        <button
          :if={@campaign.status == :archived}
          type="button"
          phx-click="restore"
          class="rounded-lg bg-amber-700 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-800"
        >{gettext("Restore campaign")}</button>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.8fr)]">
    <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">
        {gettext("Story premise")}
      </h2>
      <p class="mt-3 whitespace-pre-wrap leading-7 text-stone-800">{@campaign.premise}</p>
      <div class="mt-6 border-t border-stone-100 pt-5">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-stone-500">
          {gettext("Player character")}
        </h3>
        <dl class="mt-3 space-y-3">
          <div>
            <dt class="text-sm font-medium text-stone-500">{gettext("Character name")}</dt>
            <dd class="mt-1 text-stone-800">{@campaign.player_character_name}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-stone-500">{gettext("Character description")}</dt>
            <dd class="mt-1 whitespace-pre-wrap text-stone-800">{@campaign.player_character}</dd>
          </div>
        </dl>
      </div>
    </article>

    <aside
      :if={@campaign.status == :active}
      class="rounded-2xl border border-amber-200 bg-amber-50/60 p-6"
    >
      <h2 class="text-lg font-semibold text-stone-950">{gettext("Continue the story")}</h2>
      <p :if={!@active_session} class="mt-2 text-sm leading-6 text-stone-600">
        {gettext("Start a new play session. Earlier sessions stay attached to this campaign.")}
      </p>
      <div :if={@active_session} class="mt-3 space-y-3">
        <p class="text-sm leading-6 text-stone-600">
          {gettext("Continue the active session, or start another session below.")}
        </p>
        <.link
          navigate={~p"/campaigns/#{@campaign.id}/sessions/#{@active_session.id}"}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-amber-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-900"
        >{gettext("Resume current session")}</.link>
        <p class="rounded-lg border border-amber-200 bg-white/70 px-3 py-2 text-sm leading-6 text-stone-700">
          {gettext(
            "Starting another session completes the active session. Its full story stays saved."
          )}
        </p>
      </div>
      <.form for={%{}} as={:session} phx-submit="start-session" class="mt-5 space-y-4">
        <label for="session-title" class="block text-sm font-medium text-stone-700">{gettext(
          "Session title"
        )}
        <span class="font-normal text-stone-500">({gettext("optional")})</span></label>
        <input
          id="session-title"
          name="session[title]"
          value={@session_title}
          placeholder={gettext("Session %{number}", number: length(@campaign.sessions) + 1)}
          class="block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
        />
        <p :if={@session_error?} class="text-sm text-rose-700">
          {gettext("The session title must be 1 to 100 characters.")}
        </p>
        <.button type="submit" class="w-full justify-center bg-amber-700 hover:bg-amber-800">
          {if @active_session,
            do: gettext("Start another session"),
            else: gettext("Start new session")}
        </.button>
      </.form>
    </aside>
  </div>

  <section :if={@panels != []} id="public-campaign-panels" class="space-y-4">
    <h2 class="text-xl font-semibold text-stone-950">{gettext("Campaign panels")}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <article
        :for={panel <- @panels}
        class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"
      >
        <h3 class="font-semibold text-stone-900">{panel.name}</h3>
        <dl class="mt-3 space-y-2">
          <div
            :for={field <- panel.fields}
            class="grid min-w-0 gap-1 border-t border-stone-100 pt-2"
          >
            <dt class="break-words text-sm text-stone-600">{field.label}</dt>
            <dd class="min-w-0 text-left text-sm font-semibold text-stone-900">
              <span data-panel-value class="block whitespace-pre-wrap break-words">{panel_value(
                field.value,
                field.unit
              )}</span>
            </dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <section class="space-y-4">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-stone-950">{gettext("Sessions")}</h2>
      <span class="text-sm text-stone-500">{gettext("Continuous campaign history")}</span>
    </div>
    <div
      :if={@campaign.sessions == []}
      class="rounded-xl border border-stone-200 bg-white p-5 text-sm text-stone-600"
    >
      {gettext("No sessions have been started yet.")}
    </div>
    <ol :if={@campaign.sessions != []} class="space-y-3">
      <li
        :for={session <- @campaign.sessions}
        id={"session-#{session.id}"}
        class="flex flex-col gap-3 rounded-xl border border-stone-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-semibold text-stone-900">{session.title}</h3>
            <span class={[
              "rounded-full px-2 py-0.5 text-xs font-semibold",
              session.status == :active && "bg-emerald-50 text-emerald-800",
              session.status == :completed && "bg-stone-100 text-stone-600"
            ]}>{if session.status == :active,
              do: gettext("In progress"),
              else: gettext("Completed")}</span>
          </div>
          <p class="mt-1 text-sm text-stone-500">
            {gettext("Created %{date}", date: Calendar.strftime(session.inserted_at, "%Y-%m-%d"))}
          </p>
        </div>
        <.link
          navigate={~p"/campaigns/#{@campaign.id}/sessions/#{session.id}"}
          class="rounded-lg border border-stone-300 px-3 py-2 text-center text-sm font-semibold text-stone-800 hover:bg-stone-50"
        >{if session.status == :active,
          do: gettext("Resume session"),
          else: gettext("Review session")}</.link>
      </li>
    </ol>
  </section>

  <details id="campaign-persistence" class="rounded-xl border border-stone-200 bg-white/70 p-4">
    <summary class="cursor-pointer text-sm font-semibold text-stone-700">
      {gettext("Campaign persistence")}
    </summary>
    <div class="mt-4 space-y-5 border-t border-stone-200 pt-4">
      <p class="max-w-3xl text-sm leading-6 text-stone-600">
        {gettext(
          "Backups contain GM-only notes and full campaign history. Keep downloaded files somewhere private."
        )}
      </p>
      <div class="max-w-2xl">
        <section class="rounded-xl border border-stone-200 bg-white p-4">
          <h2 class="font-semibold text-stone-950">{gettext("Back up this campaign")}</h2>
          <p class="mt-1 text-sm leading-6 text-stone-600">
            {gettext(
              "The backup includes every session, private GM context, and the full event history. Store it somewhere private."
            )}
          </p>
          <.link
            href={~p"/campaigns/#{@campaign.id}/backup"}
            class="mt-4 inline-flex min-h-11 items-center rounded-lg border border-stone-300 px-4 py-2.5 text-sm font-semibold text-stone-800 hover:bg-stone-50"
          >
            {gettext("Download sensitive backup")}
          </.link>
        </section>
      </div>
    </div>
  </details>
</section>
