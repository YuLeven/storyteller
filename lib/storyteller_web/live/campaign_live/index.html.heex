<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-amber-800">
        {gettext("Your worlds")}
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-950">
        {gettext("Campaigns")}
      </h1>
      <p class="mt-2 max-w-2xl text-stone-600">
        {gettext("Each campaign keeps its own story and sessions in your local archive.")}
      </p>
    </div>
    <.link
      navigate={~p"/campaigns/new"}
      class="inline-flex items-center justify-center rounded-lg bg-stone-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-stone-700"
    >
      {gettext("Create a campaign")}
    </.link>
  </div>

  <section
    id="campaign-backup-import"
    class="rounded-2xl border border-amber-300/70 bg-amber-50/70 p-5 shadow-sm"
  >
    <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(16rem,0.8fr)] md:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-900">
          {gettext("Sensitive file")}
        </p>
        <h2 class="mt-1 text-lg font-semibold text-stone-950">
          {gettext("Restore a campaign copy")}
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700">
          {gettext(
            "A backup contains the full campaign history and GM-only notes. Keep the file private. Import creates a separate campaign and never replaces an existing one."
          )}
        </p>
      </div>
      <.form
        for={%{}}
        id="campaign-backup-form"
        phx-submit="import-backup"
        phx-change="validate-backup-upload"
        class="space-y-3"
      >
        <.live_file_input
          upload={@uploads.campaign_backup}
          class="block w-full text-sm text-stone-700"
        />
        <p :for={error <- upload_errors(@uploads.campaign_backup)} class="text-sm text-rose-800">
          {upload_error(error)}
        </p>
        <.button type="submit" class="w-full justify-center bg-stone-800 hover:bg-stone-900">
          {gettext("Import as a new campaign")}
        </.button>
      </.form>
    </div>
  </section>

  <div
    :if={@campaigns == []}
    class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-14 text-center"
  >
    <h2 class="text-lg font-semibold text-stone-900">{gettext("Your next story starts here")}</h2>
    <p class="mt-2 text-stone-600">
      {gettext("Create a campaign to save its setting, characters, and sessions.")}
    </p>
    <.link
      navigate={~p"/campaigns/new"}
      class="mt-6 inline-flex rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-800"
    >{gettext("Set up a campaign")}</.link>
  </div>

  <div :if={@campaigns != []} class="grid gap-5 md:grid-cols-2">
    <article
      :for={campaign <- @campaigns}
      id={"campaign-#{campaign.id}"}
      class="flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"
    >
      <% active_session = Enum.find(campaign.sessions, &(&1.status == :active)) %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold text-stone-950">
            <.link navigate={~p"/campaigns/#{campaign.id}"} class="hover:text-amber-800">{campaign.title}</.link>
          </h2>
          <p class="mt-1 text-sm text-stone-500">
            {campaign.setting} · {gettext("Narration in %{language}",
              language: campaign.narration_language
            )}
          </p>
        </div>
        <span class={[
          "rounded-full px-2.5 py-1 text-xs font-semibold",
          campaign.status == :active && "bg-emerald-50 text-emerald-800",
          campaign.status == :archived && "bg-stone-100 text-stone-600"
        ]}>{if campaign.status == :active, do: gettext("Active"), else: gettext("Archived")}</span>
      </div>

      <p class="mt-4 line-clamp-3 text-sm leading-6 text-stone-700">{campaign.premise}</p>
      <div class="mt-5 flex items-center justify-between border-t border-stone-100 pt-4 text-sm text-stone-500">
        <span>{length(campaign.sessions)} {ngettext(
          "session",
          "sessions",
          length(campaign.sessions)
        )}</span>
        <span>{gettext("Character:")} {campaign.player_character_name}</span>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <.link
          navigate={~p"/campaigns/#{campaign.id}"}
          class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-50"
        >{gettext("Campaign details")}</.link>
        <.link
          :if={active_session}
          navigate={~p"/campaigns/#{campaign.id}/sessions/#{active_session.id}"}
          class="rounded-lg bg-amber-700 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-800"
        >{gettext("Resume session")}</.link>
        <button
          :if={campaign.status == :active}
          type="button"
          phx-click="archive"
          phx-value-id={campaign.id}
          class="ml-auto px-2 py-2 text-sm text-stone-500 hover:text-stone-900"
        >{gettext("Archive")}</button>
        <button
          :if={campaign.status == :archived}
          type="button"
          phx-click="restore"
          phx-value-id={campaign.id}
          class="ml-auto px-2 py-2 text-sm font-medium text-amber-800 hover:text-amber-950"
        >{gettext("Restore")}</button>
      </div>
    </article>
  </div>
</section>
