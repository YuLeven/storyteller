<section class="mx-auto max-w-3xl space-y-8">
  <div>
    <.link navigate={~p"/"} class="text-sm font-medium text-amber-800 hover:text-amber-950">← Campaigns</.link>
    <p class="mt-6 text-sm font-medium uppercase tracking-[0.18em] text-amber-800">New world</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-950">
      Set up your campaign
    </h1>
    <p class="mt-2 text-stone-600">
      Save the story foundations now. You can return to this campaign and its sessions later.
    </p>
  </div>

  <div :if={!@reviewed} class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <.form
      for={@form}
      id="campaign-form"
      phx-change="validate"
      phx-submit="review"
      class="space-y-6"
    >
      <.input
        field={@form[:title]}
        label="Campaign title"
        placeholder="The Cartographers of Hollowmere"
        autocomplete="off"
      />
      <.input
        field={@form[:premise]}
        type="textarea"
        label="Story premise"
        placeholder="What is happening at the start of the story?"
        rows="4"
      />
      <div class="grid gap-6 sm:grid-cols-2">
        <.input
          field={@form[:setting]}
          label="Setting"
          placeholder="A remote archipelago after the long thaw"
        />
        <.input
          field={@form[:tone]}
          label="Tone"
          placeholder="Thoughtful, adventurous, and grounded"
        />
      </div>
      <.input
        field={@form[:player_character]}
        label="Player character"
        placeholder="Name and a short description"
      />
      <.input
        field={@form[:narration_language]}
        type="select"
        label="Narration language"
        options={["English", "Spanish", "French"]}
      />
      <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-6 sm:flex-row sm:justify-between">
        <.link
          navigate={~p"/"}
          class="rounded-lg px-4 py-2.5 text-center text-sm font-semibold text-stone-600 hover:bg-stone-50"
        >Cancel</.link>
        <.button type="submit" class="bg-amber-700 hover:bg-amber-800">Review campaign setup</.button>
      </div>
    </.form>
  </div>

  <div
    :if={@reviewed && @draft}
    class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
  >
    <h2 class="text-xl font-semibold text-stone-950">Review your campaign</h2>
    <p class="mt-1 text-sm text-stone-600">A first session will be created with this campaign.</p>
    <dl class="mt-6 divide-y divide-stone-100">
      <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-sm font-medium text-stone-500">Title</dt><dd class="font-semibold text-stone-900">
          {@draft.title}
        </dd>
      </div>
      <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-sm font-medium text-stone-500">Premise</dt><dd class="whitespace-pre-wrap text-stone-800">
          {@draft.premise}
        </dd>
      </div>
      <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-sm font-medium text-stone-500">Setting and tone</dt><dd class="text-stone-800">
          {@draft.setting} · {@draft.tone}
        </dd>
      </div>
      <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-sm font-medium text-stone-500">Player character</dt><dd class="text-stone-800">
          {@draft.player_character}
        </dd>
      </div>
      <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-sm font-medium text-stone-500">Narration language</dt><dd class="text-stone-800">
          {@draft.narration_language}
        </dd>
      </div>
    </dl>
    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-stone-100 pt-6 sm:flex-row sm:justify-between">
      <button
        type="button"
        phx-click="edit"
        class="rounded-lg px-4 py-2.5 text-sm font-semibold text-stone-600 hover:bg-stone-50"
      >Edit setup</button>
      <.button phx-click="create" class="bg-amber-700 hover:bg-amber-800">Create campaign</.button>
    </div>
  </div>
</section>
