<section class="mx-auto max-w-3xl space-y-8">
  <div>
    <.link
      navigate={~p"/campaigns/#{@campaign.id}"}
      class="text-sm font-medium text-amber-800 hover:text-amber-950"
    >← {gettext("Campaign")}</.link>
    <p class="mt-6 text-sm font-medium uppercase tracking-[0.18em] text-amber-800">
      {gettext("Campaign authoring")}
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-950">
      {gettext("Edit campaign setup")}
    </h1>
    <p class="mt-2 text-stone-600">
      {gettext(
        "Changes guide future GM responses. Existing sessions and story entries stay saved as they are."
      )}
    </p>
  </div>

  <.form
    for={@form}
    id="campaign-edit-form"
    phx-change="validate"
    phx-submit="save"
    class="space-y-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
  >
    <input type="hidden" name="campaign[expected_revision]" value={@state_revision} />
    <.input field={@form[:title]} label={gettext("Campaign title")} maxlength="100" />
    <.input
      field={@form[:premise]}
      type="textarea"
      label={gettext("Story premise")}
      rows="4"
      maxlength="10000"
    />
    <div class="grid gap-6 sm:grid-cols-2">
      <.input field={@form[:setting]} label={gettext("Setting")} maxlength="500" />
      <.input field={@form[:tone]} label={gettext("Tone")} maxlength="300" />
    </div>
    <.input
      field={@form[:narration_language]}
      type="select"
      label={gettext("Narration language")}
      options={[
        {gettext("English"), "English"},
        {gettext("Spanish"), "Spanish"},
        {gettext("French"), "French"}
      ]}
    />
    <.input
      field={@form[:player_character_name]}
      label={gettext("Character name")}
      maxlength="300"
      required
    />
    <.input
      field={@form[:player_character]}
      type="textarea"
      label={gettext("Character description")}
      rows="3"
      maxlength="300"
      required
    />
    <p class="-mt-4 text-sm text-stone-500">
      {gettext("These edits guide future turns and do not rewrite saved story entries.")}
    </p>

    <section class="space-y-4 border-t border-stone-100 pt-6">
      <div>
        <h2 class="text-lg font-semibold text-stone-950">
          {gettext("GM character setup")}
        </h2>
        <p class="mt-1 text-sm text-stone-600">
          {gettext(
            "Revise the current player-visible summary or GM-only notes. Other character facts and the story timeline are preserved."
          )}
        </p>
      </div>
      <div
        :for={character <- @gm_characters}
        id={"facts-#{character.speaker_id}"}
        class="space-y-4 rounded-xl border border-stone-200 bg-stone-50 p-4"
      >
        <h3 class="font-semibold text-stone-800">{character.name}</h3>
        <label class="block text-sm font-medium text-stone-700">
          {gettext("Player-visible facts")}
          <textarea
            name={"campaign[gm_character_setup][#{character.speaker_id}][visible_facts_text]"}
            maxlength="5000"
            rows="3"
            class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
          >{fact_value(character.visible_facts, "description")}</textarea>
        </label>
        <label class="block text-sm font-medium text-stone-700">
          {gettext("GM-only notes")}
          <textarea
            name={"campaign[gm_character_setup][#{character.speaker_id}][private_notes]"}
            maxlength="5000"
            rows="3"
            class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
          >{fact_value(character.gm_private_facts, "notes")}</textarea>
        </label>
        <label class="block text-sm font-medium text-stone-700">
          {gettext("Active duty (GM only, optional)")}
          <input
            type="text"
            name={"campaign[character_active_duties][#{character.speaker_id}][duty_name]"}
            value={character.duty_name || ""}
            maxlength="160"
            autocomplete="off"
            class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
          />
        </label>
        <p class="-mt-3 text-sm text-stone-500">
          {gettext(
            "While set, this character stays at their current known place. Clear the field to release the duty. This rule is hidden from the player board."
          )}
        </p>
        <details class="rounded-lg border border-stone-200 bg-white p-4">
          <summary class="cursor-pointer text-sm font-semibold text-stone-800">
            {gettext("Voice and mannerisms")}
            <span class="ml-1 font-normal text-stone-500">({gettext("optional, GM only")})</span>
          </summary>
          <p class="mt-2 text-sm text-stone-600">
            {gettext(
              "Keep delivery notes with this character's setup. Each field allows 280 characters; all notes together allow 1,200."
            )}
          </p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium text-stone-700">
              {gettext("Quirks")}
              <textarea
                name={"campaign[character_voice_guidance][#{character.speaker_id}][quirks]"}
                maxlength="280"
                rows="2"
                class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
              >{voice_value(character, "quirks")}</textarea>
            </label>
            <label class="block text-sm font-medium text-stone-700">
              {gettext("Accent or dialect")}
              <textarea
                name={"campaign[character_voice_guidance][#{character.speaker_id}][accent_dialect]"}
                maxlength="280"
                rows="2"
                class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
              >{voice_value(character, "accent_dialect")}</textarea>
            </label>
            <label class="block text-sm font-medium text-stone-700">
              {gettext("Cadence")}
              <textarea
                name={"campaign[character_voice_guidance][#{character.speaker_id}][cadence]"}
                maxlength="280"
                rows="2"
                class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
              >{voice_value(character, "cadence")}</textarea>
            </label>
            <label class="block text-sm font-medium text-stone-700">
              {gettext("Vocabulary")}
              <textarea
                name={"campaign[character_voice_guidance][#{character.speaker_id}][vocabulary]"}
                maxlength="280"
                rows="2"
                class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
              >{voice_value(character, "vocabulary")}</textarea>
            </label>
            <label class="block text-sm font-medium text-stone-700 sm:col-span-2">
              {gettext("Mannerisms")}
              <textarea
                name={"campaign[character_voice_guidance][#{character.speaker_id}][mannerisms]"}
                maxlength="280"
                rows="2"
                class="mt-1 block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
              >{voice_value(character, "mannerisms")}</textarea>
            </label>
          </div>
        </details>
      </div>
    </section>

    <section class="space-y-2 border-t border-stone-100 pt-6">
      <label for="campaign-correction-reason" class="block text-sm font-medium text-stone-700">
        {gettext("Why are you changing the setup?")}
      </label>
      <input
        id="campaign-correction-reason"
        type="text"
        name="campaign[correction_reason]"
        value={@correction_reason}
        maxlength="1000"
        class="block w-full rounded-lg border-stone-300 shadow-sm focus:border-amber-700 focus:ring-amber-700"
      />
      <p class="text-sm text-stone-500">
        {gettext(
          "A reason is required when a setup value changes. Saving unchanged setup does not create a correction."
        )}
      </p>
    </section>

    <p :if={@save_error} class="rounded-lg bg-rose-50 p-3 text-sm text-rose-800">{@save_error}</p>
    <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-6 sm:flex-row sm:justify-between">
      <.link
        navigate={~p"/campaigns/#{@campaign.id}"}
        class="rounded-lg px-4 py-2.5 text-center text-sm font-semibold text-stone-600 hover:bg-stone-50"
      >{gettext("Cancel")}</.link>
      <.button type="submit" class="bg-amber-700 hover:bg-amber-800">{gettext(
        "Save campaign changes"
      )}</.button>
    </div>
  </.form>

  <details
    id="authoring-correction-history"
    class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"
  >
    <summary class="cursor-pointer font-semibold text-stone-900">
      {gettext("Setup correction history")}
      <span class="ml-1 font-normal text-stone-500">({length(@authoring_corrections)})</span>
    </summary>
    <p class="mt-2 text-sm text-stone-600">
      {gettext(
        "Public setup corrections are listed here. Corrections that include GM-private changes are omitted."
      )}
    </p>
    <p :if={@authoring_corrections == []} class="mt-4 text-sm text-stone-500">
      {gettext("No public setup corrections have been recorded.")}
    </p>
    <ol :if={@authoring_corrections != []} class="mt-4 space-y-3">
      <li
        :for={correction <- @authoring_corrections}
        id={"authoring-correction-#{correction.sequence}"}
        class="rounded-xl border border-stone-100 bg-stone-50 p-4"
      >
        <p class="text-sm font-medium text-stone-900">{correction.reason}</p>
        <p class="mt-1 text-xs text-stone-500">
          {Calendar.strftime(correction.inserted_at, "%Y-%m-%d %H:%M UTC")}
        </p>
        <ul class="mt-2 flex flex-wrap gap-2">
          <li
            :for={category <- correction.summary_categories}
            class="rounded-full bg-white px-2.5 py-1 text-xs text-stone-600"
          >
            {correction_category_label(category)}
          </li>
        </ul>
      </li>
    </ol>
  </details>
</section>
