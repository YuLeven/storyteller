<section class="play-page mx-auto max-w-7xl space-y-6">
  <header class="flex flex-col gap-5 border-b border-stone-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <.link
        navigate={~p"/campaigns/#{@session.campaign.id}"}
        class="text-sm font-semibold text-amber-800 hover:text-amber-950"
      >← {@session.campaign.title}</.link>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight text-stone-950">{@session.title}</h1>
        <span class={[
          "rounded-full px-2.5 py-1 text-xs font-semibold",
          @session.status == :active && @session.campaign.status == :active &&
            "bg-emerald-50 text-emerald-800",
          (@session.status == :completed or @session.campaign.status == :archived) &&
            "bg-stone-100 text-stone-600"
        ]}>{if @session.status == :active and @session.campaign.status == :active,
          do: gettext("In progress"),
          else: gettext("Reviewing")}</span>
      </div>
      <p class="mt-2 text-sm text-stone-600">
        {@session.campaign.setting} <span aria-hidden="true">·</span>
        {gettext("Playing as %{character}", character: @session.campaign.player_character_name)}
      </p>
    </div>
  </header>

  <details
    id="campaign-premise"
    class="rounded-xl border border-stone-200 bg-white/70 px-4 py-3 text-sm shadow-sm"
  >
    <summary class="cursor-pointer font-semibold text-stone-700 hover:text-stone-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
      {gettext("Story premise")}
    </summary>
    <p class="mt-3 border-t border-stone-200 pt-3 leading-6 text-stone-700">
      {@session.campaign.premise}
    </p>
  </details>

  <p
    :if={@game_error}
    role="alert"
    class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800"
  >
    {@game_error}
  </p>

  <p id="turn-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true">
    {@turn_announcement}
  </p>

  <section
    :if={@plan_usage_paused?}
    id="plan-usage-paused"
    role="status"
    class="rounded-2xl border border-amber-300 bg-amber-50 px-5 py-4"
  >
    <h2 class="font-semibold text-amber-950">{gettext("Game master responses are paused")}</h2>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-amber-900">
      {gettext(
        "ChatGPT reported an account usage limit. The game master cannot respond in any session until account usage is available. Check Usage settings; when you believe usage is available, resume requests here. Resuming only clears the pause; it does not send anything. Then retry a saved turn or start a new one."
      )}
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-4">
      <a
        href="https://chatgpt.com/settings/usage"
        target="_blank"
        rel="noreferrer"
        class="text-sm font-semibold text-amber-950 underline underline-offset-2"
      >{gettext("Check ChatGPT Usage")}</a>
      <button
        type="button"
        phx-click="resume-plan-usage"
        class="rounded-lg bg-amber-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-950"
      >{gettext("Resume requests")}</button>
    </div>
  </section>

  <section
    :if={@plan_usage_status == :unavailable}
    id="plan-usage-unavailable"
    role="status"
    class="rounded-2xl border border-amber-300 bg-amber-50 px-5 py-4"
  >
    <h2 class="font-semibold text-amber-950">
      {gettext("Account usage status unavailable")}
    </h2>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-amber-900">
      {gettext(
        "Storyteller cannot verify account usage right now. New game master requests are held until the status can be checked. A request already in progress may still finish. This does not mean ChatGPT reported a usage limit."
      )}
    </p>
    <button
      type="button"
      phx-click="check-plan-usage-status"
      class="mt-3 rounded-lg bg-amber-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-950"
    >{gettext("Check again")}</button>
  </section>

  <div :if={@projection} class="space-y-6">
    <section
      id="campaign-panels"
      phx-hook="PanelPulse"
      data-panel-change-message={gettext("World details updated")}
      aria-label={gettext("Current world details")}
      class="relative grid gap-3 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-4"
    >
      <p
        class="sr-only"
        data-panel-announcement
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
      <div class="rounded-xl bg-stone-50 px-4 py-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-stone-500">
          {gettext("In-world date")}
        </h2>
        <p
          id="world-date"
          data-panel-watch="world-date"
          class="mt-1 text-sm font-semibold text-stone-900"
        >
          {world_display(@projection.world, [
            "date",
            "current_date",
            "world_date",
            "calendar_date",
            "world_time"
          ])}
        </p>
      </div>
      <div class="rounded-xl bg-stone-50 px-4 py-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-stone-500">
          {gettext("Time")}
        </h2>
        <p
          id="world-time"
          data-panel-watch="world-time"
          class="mt-1 text-sm font-semibold text-stone-900"
        >
          {world_display(@projection.world, ["time", "current_time", "time_of_day", "world_time"])}
        </p>
        <p
          :if={@projection.elapsed_world_clock.minutes_since_anchor > 0}
          id="elapsed-world-time"
          data-panel-watch="elapsed-world-time"
          class="mt-1 text-xs font-medium text-stone-500"
        >
          {elapsed_clock_text(@projection.elapsed_world_clock.minutes_since_anchor)}
        </p>
      </div>
      <div class="rounded-xl bg-stone-50 px-4 py-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-stone-500">
          {gettext("Weather")}
        </h2>
        <div class="mt-1 flex items-center gap-2">
          <.scene_weather_icon world={@projection.world} />
          <p
            id="world-weather"
            data-panel-watch="world-weather"
            class="text-sm font-semibold text-stone-900"
          >
            {world_display(@projection.world, ["weather", "conditions"])}
          </p>
        </div>
      </div>
      <div class="rounded-xl bg-stone-50 px-4 py-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-stone-500">
          {gettext("Location")}
        </h2>
        <p
          id="world-location"
          data-panel-watch="world-location"
          class="mt-1 text-sm font-semibold text-stone-900"
        >
          {player_world_location(@player_character, @projection.world)}
        </p>
      </div>
    </section>

    <nav
      id="session-sections"
      aria-label={gettext("Session sections")}
      class="sticky top-0 z-20 -mx-4 flex min-w-0 items-center border-b border-stone-200 bg-white/95 px-4 py-2 shadow-sm backdrop-blur lg:hidden"
    >
      <ul class="flex min-w-0 gap-2 overflow-x-auto whitespace-nowrap py-1">
        <li :if={playable?(@session)}>
          <a
            href="#turn-composer-card"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Your turn")}</a>
        </li>
        <li>
          <a
            href="#current-place"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("The scene")}</a>
        </li>
        <li>
          <a
            href="#story-timeline"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Campaign story")}</a>
        </li>
        <li :if={@player_character}>
          <a
            href="#player-character-at-a-glance"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Your character")}</a>
        </li>
        <li>
          <a
            href="#character-inventory"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Inventory")}</a>
        </li>
        <li :if={@projection.objectives != []}>
          <a
            href="#campaign-reference"
            phx-click="open-campaign-reference"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Objectives")}</a>
        </li>
        <li :if={@projection.panels != []}>
          <a
            href="#campaign-fields"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Tracked resources")}</a>
        </li>
        <li>
          <a
            href="#campaign-reference"
            phx-click="open-campaign-reference"
            class="inline-flex min-h-10 items-center rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100"
          >{gettext("Campaign memory")}</a>
        </li>
      </ul>
    </nav>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]">
      <main class="min-w-0 space-y-5">
        <section
          :if={
            @current_turn && @current_turn.status in [:pending, :resolving] &&
              @auto_recovery_turn_id != @current_turn.id
          }
          id="turn-status"
          class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4"
        >
          <span class="mt-1 h-2.5 w-2.5 shrink-0 animate-pulse rounded-full bg-amber-600"></span>
          <div>
            <h2 class="font-semibold text-amber-950">
              {cond do
                opening_scene?(@current_turn) and
                    @turn_first_output_id == @current_turn.id ->
                  gettext("The opening scene is taking shape")

                opening_scene?(@current_turn) ->
                  gettext("The game master is preparing the opening scene")

                @worker_turn_id == @current_turn.id and
                    @turn_first_output_id == @current_turn.id ->
                  gettext("The game master is shaping the scene")

                @worker_turn_id == @current_turn.id ->
                  gettext("The game master is responding")

                true ->
                  gettext("Your turn is saved")
              end}
            </h2>
            <p class="mt-1 text-sm leading-6 text-amber-900">
              {cond do
                opening_scene?(@current_turn) and
                    @turn_first_output_id == @current_turn.id ->
                  gettext("You can begin your first turn as soon as the opening scene is ready.")

                opening_scene?(@current_turn) ->
                  gettext("The opening scene must be ready before you take your first action.")

                @worker_turn_id == @current_turn.id and
                    @turn_first_output_id == @current_turn.id ->
                  gettext(
                    "Your action is saved. The GM's reply will appear here once the scene is ready."
                  )

                @worker_turn_id == @current_turn.id ->
                  gettext(
                    "The scene is being updated. You can leave and return; this turn will remain here."
                  )

                true ->
                  gettext("Reconnecting to the saved turn…")
              end}
            </p>
            <p
              :if={
                @turn_long_wait_turn_id == @current_turn.id and
                  @turn_long_wait_worker_tag == @worker_tag
              }
              id="turn-long-wait-note"
              class="mt-2 text-sm leading-6 text-amber-900"
            >
              {gettext(
                "This is taking a little longer. This turn is saved; the complete, checked GM response will appear here when it is ready."
              )}
            </p>
          </div>
        </section>

        <section
          :if={@current_turn && @auto_recovery_turn_id == @current_turn.id}
          id="turn-auto-recovery"
          role="status"
          class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4"
        >
          <span class="mt-1 h-2.5 w-2.5 shrink-0 animate-pulse rounded-full bg-amber-600"></span>
          <div>
            <h2 class="font-semibold text-amber-950">
              {gettext("Reconnecting to the game master")}
            </h2>
            <p class="mt-1 text-sm leading-6 text-amber-900">
              {gettext(
                "Your action is saved. Storyteller is retrying this same turn automatically; you do not need to send it again."
              )}
            </p>
          </div>
        </section>

        <section
          :if={
            @current_turn && @current_turn.status == :failed &&
              @auto_recovery_turn_id != @current_turn.id
          }
          id="turn-error"
          class={
            if @current_turn.failure_code in [
                 "usage_limit",
                 "context_budget_exceeded",
                 "context_followup_too_large"
               ],
               do:
                 if(@plan_usage_paused?,
                   do: "rounded-2xl border border-stone-200 bg-white p-5",
                   else: "rounded-2xl border border-amber-300 bg-amber-50 p-5"
                 ),
               else: "rounded-2xl border border-rose-200 bg-rose-50 p-5"
          }
        >
          <h2 class="font-semibold text-stone-950">
            {if @current_turn.failure_code == "usage_limit",
              do: gettext("Your turn is saved"),
              else: gettext("This turn needs attention")}
          </h2>
          <p
            :if={
              @current_turn.failure_code not in [
                "context_budget_exceeded",
                "context_followup_too_large"
              ] and not (@current_turn.failure_code == "usage_limit" and @plan_usage_paused?)
            }
            class={
              if @current_turn.failure_code == "usage_limit",
                do: "mt-1 text-sm leading-6 text-amber-950",
                else: "mt-1 text-sm leading-6 text-rose-800"
            }
          >
            {failure_message(@current_turn, @plan_usage_status)}
          </p>
          <div
            :if={
              @current_turn.failure_code in [
                "context_budget_exceeded",
                "context_followup_too_large"
              ]
            }
            id="context-budget-recovery"
            class="mt-3 rounded-xl border border-amber-200 bg-white/80 p-4"
          >
            <p class="text-sm font-medium leading-6 text-stone-800">
              {failure_message(@current_turn, @plan_usage_status)}
            </p>
            <p
              :if={@current_turn.failure_code == "context_budget_exceeded"}
              id="context-budget-diagnostics"
              class="mt-2 text-sm leading-6 text-stone-700"
            >
              {context_budget_diagnostics_message(
                Map.get(@current_turn, :context_budget_diagnostics)
              )}
            </p>
            <p
              :if={@current_turn.failure_code == "context_budget_exceeded"}
              id="context-budget-next-step"
              class="mt-2 text-sm leading-6 text-stone-700"
            >
              {context_budget_next_step_message(
                Map.get(@current_turn, :context_budget_diagnostics)
              )}
            </p>
            <p
              :if={@current_turn.failure_code == "context_followup_too_large"}
              id="context-budget-next-step"
              class="mt-2 text-sm leading-6 text-stone-700"
            >
              {gettext(
                "Retry this turn to send a new GM request. It will use the same saved action without duplicating it."
              )}
            </p>
            <div
              :if={@current_turn.failure_code == "context_budget_exceeded"}
              class="mt-3 flex flex-wrap gap-3"
            >
              <.link
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :campaign
                }
                navigate={~p"/campaigns/#{@session.campaign.id}"}
                id="context-budget-open-campaign"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >
                {gettext("Campaign")}
              </.link>
              <.link
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :setup
                }
                navigate={~p"/campaigns/#{@session.campaign.id}/edit"}
                id="context-budget-edit-setup"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >
                {gettext("Edit campaign setup")}
              </.link>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :inventory
                }
                href="#campaign-tools"
                phx-click="review-context-budget-correction"
                phx-value-kind="inventory"
                id="context-budget-review-inventory"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Inventory")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :resource
                }
                href="#campaign-tools"
                phx-click="review-context-budget-correction"
                phx-value-kind="resource"
                id="context-budget-review-resource"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Tracked resources")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :world
                }
                href="#campaign-tools"
                phx-click="review-context-budget-correction"
                phx-value-kind="world"
                id="context-budget-review-world"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Correct tracked state")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :place
                }
                href="#campaign-tools"
                phx-click="review-context-budget-correction"
                phx-value-kind="place"
                id="context-budget-review-place"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Correct place details")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :travel_connection
                }
                href="#campaign-tools"
                phx-click="review-context-budget-correction"
                phx-value-kind="travel_connection"
                id="context-budget-review-travel-connection"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Correct travel details")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :objective
                }
                href="#canon-corrections"
                phx-click="review-context-budget-correction"
                phx-value-kind="objective"
                id="context-budget-review-objectives"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Review objectives")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :scene
                }
                href="#current-place"
                id="context-budget-review-scene"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("The scene")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :reference
                }
                href="#campaign-reference"
                phx-click="open-campaign-reference"
                id="context-budget-review-reference"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Campaign memory")}</a>
              <a
                :if={
                  context_budget_recovery_type(
                    Map.get(@current_turn, :context_budget_diagnostics)
                  ) == :timeline
                }
                href="#story-timeline"
                id="context-budget-review-timeline"
                class="inline-flex rounded-lg border border-amber-700 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-50"
              >{gettext("Campaign story")}</a>
            </div>
          </div>
          <p
            :if={
              @current_turn.failure_code == "usage_limit" and
                not @plan_usage_paused? and
                not (@current_turn.failure_code == "usage_limit" and
                       @current_turn.resolution_phase == :after_roll)
            }
            class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-sm text-stone-700"
          >
            {gettext("Your action is saved below. Retry continues this same turn.")}
          </p>
          <p
            :if={opening_scene?(@current_turn)}
            class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-sm text-stone-700"
          >
            {gettext(
              "The opening scene has not been recorded yet. Retry it before choosing what to do."
            )}
          </p>
          <p
            :if={@current_turn.resolution_phase == :after_roll}
            class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-sm font-semibold text-stone-800"
          >
            {gettext("D20 result:")} {@current_turn_roll}
          </p>
          <p
            :if={
              retryable?(@current_turn) && playable?(@session) &&
                @current_turn.resolution_phase == :after_roll
            }
            class={
              if @current_turn.failure_code == "usage_limit",
                do: "mt-3 text-sm leading-6 text-amber-950",
                else: "mt-3 text-sm leading-6 text-rose-800"
            }
          >
            {gettext("Your D20 result is saved. Retry continues this same turn with that result.")}
          </p>
          <div id="turn-error-actions" class="mt-4 flex flex-wrap items-center gap-3">
            <button
              :if={
                retryable?(@current_turn) && playable?(@session) &&
                  @current_turn.failure_code not in [
                    "context_length_exceeded",
                    "context_followup_too_large"
                  ]
              }
              type="button"
              phx-click="retry-turn"
              phx-value-turn_id={@current_turn.id}
              disabled={@worker_turn_id == @current_turn.id || @plan_usage_blocked?}
              class={
                if @current_turn.failure_code == "usage_limit",
                  do:
                    "rounded-lg bg-amber-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-950 disabled:cursor-wait disabled:opacity-60",
                  else:
                    "rounded-lg bg-rose-800 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-900 disabled:cursor-wait disabled:opacity-60"
              }
            >{cond do
              @worker_turn_id == @current_turn.id -> gettext("Retrying…")
              opening_scene?(@current_turn) -> gettext("Retry opening scene")
              true -> gettext("Retry this turn")
            end}</button>
            <button
              :if={
                retryable?(@current_turn) && playable?(@session) &&
                  @current_turn.failure_code in [
                    "context_length_exceeded",
                    "context_followup_too_large"
                  ]
              }
              type="button"
              phx-click="retry-turn"
              phx-value-turn_id={@current_turn.id}
              id="retry-with-compact-context"
              disabled={@worker_turn_id == @current_turn.id || @plan_usage_blocked?}
              class="rounded-lg bg-amber-800 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-900 disabled:cursor-wait disabled:opacity-60"
            >{cond do
              @worker_turn_id == @current_turn.id ->
                gettext("Retrying with a compact scene brief…")

              minimal_context_retry?(@current_turn) ->
                gettext("Retry with a minimal scene brief")

              true ->
                gettext("Retry with a compact scene brief")
            end}</button>
            <.link
              :if={reconnect_needed?(@current_turn.failure_code)}
              navigate="/auth/connect"
              class="text-sm font-semibold text-amber-900 underline decoration-amber-400 underline-offset-4 hover:text-amber-950"
            >{gettext("Reconnect account")}</.link>
          </div>
        </section>

        <section
          :if={
            @current_turn && @current_turn.status == :awaiting_roll &&
              valid_roll_request?(@current_turn.roll_request)
          }
          id="roll-panel"
          class="rounded-2xl border border-violet-200 bg-violet-50 p-5"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-violet-800">
            {gettext("Your roll")}
          </p>
          <h2 class="mt-1 text-lg font-semibold text-violet-950">
            {@current_turn.roll_request["test"] || @current_turn.roll_request[:test]}
          </h2>
          <p class="mt-1 text-sm text-violet-900">
            <span :if={
              @current_turn.roll_request["difficulty"] || @current_turn.roll_request[:difficulty]
            }>
              {gettext("Difficulty:")} {@current_turn.roll_request["difficulty"] ||
                @current_turn.roll_request[:difficulty]}
            </span>
            <span :if={
              @current_turn.roll_request["target"] || @current_turn.roll_request[:target]
            }>
              {gettext("Target:")} {@current_turn.roll_request["target"] ||
                @current_turn.roll_request[:target]}
            </span>
          </p>
          <p class="mt-3 text-sm leading-6 text-violet-900">
            {gettext("The game master is waiting. Click only when you are ready to roll the D20.")}
          </p>
          <button
            type="button"
            phx-click="roll-d20"
            phx-value-turn_id={@current_turn.id}
            disabled={@plan_usage_blocked?}
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-violet-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-900"
          >
            <span aria-hidden="true">⚄</span> {gettext("Roll D20")}
          </button>
        </section>

        <section class="rounded-2xl border border-stone-200 bg-white shadow-sm">
          <div class="border-b border-stone-100 px-5 py-4 sm:px-7">
            <h2 class="text-lg font-semibold text-stone-950">{gettext("Campaign story")}</h2>
            <p class="mt-1 text-sm text-stone-500">
              {gettext("The timeline continues across every session in this campaign.")}
            </p>
          </div>
          <div
            :if={@timeline == []}
            id="empty-timeline"
            class="px-6 py-12 text-center"
          >
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-2xl text-amber-800">
              ✦
            </div>
            <h3 class="mt-4 font-semibold text-stone-900">{gettext("A new scene begins")}</h3>
            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-stone-600">
              {gettext("The game master is preparing the opening scene for your first choice.")}
            </p>
          </div>
          <div
            id="story-timeline"
            tabindex="0"
            phx-hook="StoryTimeline"
            data-story-announcement-prefix={gettext("New story:")}
            data-story-all-ready={gettext("New story is ready.")}
            role="region"
            aria-label={gettext("Campaign story")}
            class="scroll-mt-20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
          >
            <div
              id="story-reveal-controls"
              class="story-reveal-controls sticky top-0 z-10 flex items-center justify-between gap-3 px-4 py-2 sm:px-7"
              hidden
            >
              <p class="text-xs font-medium text-amber-100">
                {gettext("The scene is unfolding…")}
              </p>
              <button
                type="button"
                data-story-show-all
                class="shrink-0 rounded-lg border border-amber-300 bg-stone-900 px-3 py-1.5 text-xs font-semibold text-amber-100 hover:bg-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
              >{gettext("Show all new messages")}</button>
            </div>
            <p
              id="story-reveal-announcement"
              class="sr-only"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            >
            </p>
            <button
              :if={@timeline_has_earlier?}
              id="load-earlier-story"
              type="button"
              phx-click="load-earlier-story"
              class="mx-4 mt-4 rounded-lg border border-amber-300 bg-stone-900 px-4 py-2 text-sm font-semibold text-amber-100 hover:bg-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 sm:mx-7"
            >{gettext("Load earlier story")}</button>
            <ol
              :if={@timeline_history != []}
              id="story-history"
              aria-label={gettext("Earlier campaign story")}
              class="story-timeline space-y-4 px-4 py-5 sm:px-7"
            >
              <.timeline_entry
                :for={{event, earlier_session?, show_game_time?} <- @timeline_history}
                event={event}
                earlier_session?={earlier_session?}
                show_game_time?={show_game_time?}
                characters_by_id={@characters_by_id}
                projection={@projection}
              />
            </ol>
            <ol
              id="story-live-timeline"
              aria-label={gettext("Recent campaign story")}
              aria-live="polite"
              aria-relevant="additions"
              aria-atomic="false"
              class="story-timeline space-y-4 px-4 py-5 sm:px-7"
            >
              <.timeline_entry
                :for={{event, earlier_session?, show_game_time?} <- @timeline_live}
                event={event}
                earlier_session?={earlier_session?}
                show_game_time?={show_game_time?}
                characters_by_id={@characters_by_id}
                projection={@projection}
              />
            </ol>
            <ol
              :if={
                is_binary(@turn_preview) and
                  @turn_preview_turn_id == (@current_turn && @current_turn.id)
              }
              id="story-provisional-preview"
              aria-label={gettext("Provisional game master narration")}
              aria-live="off"
              class="story-timeline space-y-4 px-4 pb-5 sm:px-7"
            >
              <li class="min-w-0" data-preview-turn-id={@turn_preview_turn_id}>
                <article class="story-entry story-entry-gm opacity-90">
                  <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h3 class="text-xs font-semibold uppercase tracking-wide text-stone-600">
                      {gettext("Game master · live draft")}
                    </h3>
                    <p class="text-[11px] text-stone-400">{gettext("May change")}</p>
                  </div>
                  <p class="whitespace-pre-wrap leading-7 text-stone-800">{@turn_preview}</p>
                </article>
              </li>
            </ol>
            <ol
              :if={pending_action_preview?(@current_turn, @timeline)}
              id="story-pending-action"
              aria-label={pending_input_label(@current_turn.intent)}
              class="story-timeline space-y-4 px-4 pb-5 sm:px-7"
            >
              <li
                id={"pending-action-#{@current_turn.id}"}
                data-pending-turn-id={@current_turn.id}
                class="min-w-0"
              >
                <article class="story-entry story-entry-player">
                  <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h3 class="text-xs font-semibold uppercase tracking-wide text-stone-600">
                      {pending_input_label(@current_turn.intent)}
                    </h3>
                    <p class="text-[11px] text-stone-400">{gettext("Turn saved")}</p>
                  </div>
                  <p class="whitespace-pre-wrap leading-7 text-stone-800">
                    {@current_turn.player_input}
                  </p>
                </article>
              </li>
            </ol>
          </div>
        </section>

        <section
          :if={playable?(@session)}
          id="turn-composer-card"
          tabindex="-1"
          aria-label={gettext("Your turn")}
          class="scroll-mt-20 rounded-2xl border border-amber-200 bg-amber-50/70 p-4 shadow-sm sm:p-5"
        >
          <.form
            for={%{}}
            as={:turn}
            phx-submit="submit-turn"
            phx-change="change-input"
            id="turn-composer"
          >
            <input type="hidden" name="turn[idempotency_key]" value={@submission_key} />
            <input
              type="hidden"
              name="turn[intent]"
              value={Atom.to_string(@interaction_mode)}
            />
            <div class="turn-mode-nudge-row mb-3 flex flex-wrap items-center justify-between gap-2">
              <div
                role="group"
                aria-label={gettext("How do you want to interact?")}
                class="flex flex-wrap gap-2"
              >
                <button
                  :for={
                    {mode, label} <- [
                      {:action, gettext("Act or say")},
                      {:question, gettext("Ask the GM")},
                      {:time_passage, gettext("Let time pass")}
                    ]
                  }
                  type="button"
                  phx-click="select-mode"
                  phx-value-mode={Atom.to_string(mode)}
                  aria-pressed={@interaction_mode == mode}
                  class={[
                    "rounded-full border px-3 py-1.5 text-sm font-semibold transition",
                    @interaction_mode == mode &&
                      "border-amber-800 bg-amber-800 text-white",
                    @interaction_mode != mode &&
                      "border-amber-300 bg-white text-amber-950 hover:bg-amber-50"
                  ]}
                >{label}</button>
              </div>
              <div class="flex flex-wrap gap-2" aria-label={gettext("Helpful prompts")}>
                <button
                  :for={nudge <- contextual_nudges(@interaction_mode, @projection)}
                  type="button"
                  phx-click="use-nudge"
                  phx-value-nudge_id={nudge.id}
                  disabled={@plan_usage_blocked? || turn_blocks_composer?(@current_turn)}
                  class="rounded-full border border-stone-300 bg-white px-3 py-1.5 text-xs font-medium text-stone-700 hover:border-amber-400 hover:bg-amber-50 disabled:cursor-not-allowed disabled:opacity-50"
                >{nudge.label}</button>
              </div>
            </div>
            <label for="turn-input" class="block text-sm font-semibold text-stone-900">
              {composer_label(@interaction_mode)}
            </label>
            <textarea
              id="turn-input"
              name="turn[input]"
              rows="3"
              maxlength="20000"
              phx-debounce="blur"
              phx-hook="ActionComposer"
              placeholder={composer_placeholder(@interaction_mode)}
              disabled={
                @plan_usage_blocked? ||
                  turn_blocks_composer?(@current_turn)
              }
              class="mt-2 block w-full resize-y rounded-xl border-stone-300 bg-white shadow-sm placeholder:text-stone-400 focus:border-amber-700 focus:ring-amber-700 disabled:bg-stone-100"
            >{@draft}</textarea>
            <p
              :if={
                @turn_announcement != "" && (!@current_turn || @current_turn.status != :failed)
              }
              id="composer-turn-status"
              role="status"
              aria-live="off"
              class="mt-2 rounded-lg border border-amber-300/70 bg-stone-900/70 px-3 py-2 text-sm font-medium text-amber-100"
            >
              {@turn_announcement}
            </p>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-xs leading-5 text-stone-600">
                {composer_guidance(@interaction_mode)} {gettext("Press Ctrl+Enter to send.")}
              </p>
              <button
                type="submit"
                disabled={
                  !playable?(@session) ||
                    @plan_usage_blocked? ||
                    turn_blocks_composer?(@current_turn)
                }
                class="inline-flex justify-center rounded-lg bg-amber-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-900 disabled:cursor-not-allowed disabled:opacity-50"
              >{composer_submit_label(@interaction_mode)}</button>
            </div>
            <div
              id="chatgpt-plan-status"
              class="mt-3 flex flex-col gap-1 border-t border-stone-200 pt-3 text-xs sm:flex-row sm:items-center sm:justify-between"
            >
              <p :if={@plan_usage_enabled?} class="font-medium text-emerald-900">
                {gettext("Using ChatGPT plan")}
              </p>
              <.link
                :if={!@plan_usage_enabled?}
                navigate={~p"/auth/connect"}
                class="font-medium text-amber-900 underline decoration-amber-800/50 underline-offset-2 hover:text-amber-700"
              >
                {gettext("Connect ChatGPT to power the game master")}
              </.link>
              <a
                :if={@plan_usage_enabled?}
                href="https://chatgpt.com/settings/usage"
                target="_blank"
                rel="noreferrer"
                class="font-medium text-amber-900 underline decoration-amber-800/50 underline-offset-2 hover:text-amber-700"
              >
                {gettext("Manage usage")}
              </a>
            </div>
            <p :if={@input_error?} role="alert" class="mt-2 text-sm text-rose-700">
              {gettext("Enter an action or something to say before sending.")}
            </p>
          </.form>
        </section>

        <section
          :if={!playable?(@session)}
          class="rounded-2xl border border-stone-200 bg-stone-50 p-5 text-sm leading-6 text-stone-600"
        >
          {gettext("This session is read-only. Its story remains part of the campaign history.")}
        </section>
      </main>

      <aside class="play-sidebar space-y-5 self-start lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:overflow-y-auto lg:overscroll-y-auto">
        <section
          :if={@projection.panels != []}
          id="campaign-fields"
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Tracked resources updated")}
          tabindex="-1"
          class="scroll-mt-20 space-y-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
              {gettext("Campaign details")}
            </p>
            <h2 class="mt-1 text-lg font-semibold text-stone-950">
              {gettext("Tracked resources")}
            </h2>
          </div>
          <section
            :for={{panel, panel_index} <- Enum.with_index(@projection.panels)}
            class="col-span-full min-w-0 border-t border-stone-100 pt-3 first:border-0 first:pt-0"
          >
            <h3 class="resource-copy min-w-0 font-semibold text-stone-900">{panel.name}</h3>
            <dl class="mt-3 space-y-3">
              <.tracked_resource_field
                :for={field <- Enum.take(panel.fields, 4)}
                field={field}
                latest_change={Map.get(@projection.latest_panel_changes, field.key)}
                can_correct={
                  correctable_resource?(field.key, @correction_options) and
                    not blocking_turn?(@current_turn)
                }
              />
            </dl>
            <details
              :if={length(panel.fields) > 4}
              id={"tracked-resources-more-#{panel_index}"}
              class="mt-2 border-t border-stone-100 pt-2"
            >
              <summary class="cursor-pointer text-sm font-semibold text-amber-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                {gettext("See %{count} more", count: length(panel.fields) - 4)}
              </summary>
              <dl class="mt-2 space-y-3">
                <.tracked_resource_field
                  :for={field <- Enum.drop(panel.fields, 4)}
                  field={field}
                  latest_change={Map.get(@projection.latest_panel_changes, field.key)}
                  can_correct={
                    correctable_resource?(field.key, @correction_options) and
                      not blocking_turn?(@current_turn)
                  }
                />
              </dl>
            </details>
          </section>
        </section>

        <section
          id="campaign-reference"
          tabindex="-1"
          class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <button
            type="button"
            phx-click="toggle-campaign-reference"
            aria-expanded={to_string(@campaign_reference_open?)}
            aria-controls="campaign-memory campaign-objectives"
            class="w-full cursor-pointer rounded-lg text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
          >
            <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
              {gettext("Campaign details")}
            </span>
            <span class="mt-0.5 block text-sm font-semibold text-stone-800">
              {gettext("Campaign memory")} · {gettext("Objectives")}
            </span>
          </button>
        </section>
        <section
          id="campaign-memory"
          hidden={!@campaign_reference_open?}
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Campaign memory updated")}
          tabindex="-1"
          class="scroll-mt-20 rounded-2xl border border-violet-900/70 bg-violet-950/50 p-4 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <details>
            <summary class="cursor-pointer list-none rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-300">
              <span class="flex items-center justify-between gap-3">
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-violet-300">
                    {gettext("Campaign memory")}
                  </span>
                  <span class="mt-1 block text-sm font-semibold text-stone-100">
                    {gettext("Known story details")}
                  </span>
                </span>
                <span
                  data-panel-watch="memory-count"
                  class="shrink-0 rounded-full bg-stone-900 px-2.5 py-1 text-xs font-semibold text-violet-100"
                >
                  {length(@projection.continuity_entries)}
                  <span class="sr-only">{gettext("recorded details")}</span>
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-stone-300">
              {gettext(
                "Public facts, relationships, and promises that the game remembers across sessions."
              )}
            </p>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
              <p :if={@correction_options} class="text-xs font-medium text-violet-200">
                {gettext("Your kept notes: %{count} of %{limit}",
                  count: @correction_options.player_memory_count,
                  limit: @correction_options.player_memory_limit
                )}
              </p>
              <button
                :if={playable?(@session) and not is_nil(@correction_options)}
                type="button"
                phx-click="open-story-memory"
                phx-value-entry_id="new"
                disabled={
                  blocking_turn?(@current_turn) or
                    @correction_options.player_memory_count >=
                      @correction_options.player_memory_limit
                }
                class="rounded-full border border-violet-600 bg-violet-900/80 px-3 py-1.5 text-xs font-semibold text-white hover:bg-violet-800 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {gettext("Keep a detail")}
              </button>
            </div>
            <p :if={@memory_status} class="mt-2 text-sm font-medium text-violet-200">
              {@memory_status}
            </p>
            <ul
              :if={@projection.continuity_entries != []}
              class="mt-3 space-y-2"
            >
              <li
                :for={entry <- Enum.reverse(@projection.continuity_entries)}
                id={"campaign-memory-#{entry.entry_id}"}
                data-panel-watch={"memory-#{entry.entry_id}"}
                class="rounded-xl border border-violet-800 bg-violet-950/40 px-3 py-2.5"
              >
                <h3 class="text-sm font-semibold text-stone-100">{entry.title}</h3>
                <span class="mt-1 inline-flex rounded-full bg-violet-950 px-2 py-0.5 text-[0.6875rem] font-medium text-violet-200">
                  {story_memory_kind_label(entry.kind)}
                </span>
                <p class="mt-1 whitespace-pre-wrap text-sm leading-6 text-stone-200">
                  {entry.details}
                </p>
                <button
                  :if={playable?(@session) and not is_nil(@correction_options)}
                  type="button"
                  phx-click="open-story-memory"
                  phx-value-entry_id={entry.entry_id}
                  disabled={blocking_turn?(@current_turn)}
                  class="mt-2 rounded-full px-2.5 py-1 text-xs font-semibold text-violet-200 hover:bg-violet-900/60 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {gettext("Edit detail")}
                </button>
              </li>
            </ul>
            <p
              :if={@projection.continuity_entries == []}
              class="mt-3 text-sm leading-6 text-stone-400"
            >
              {gettext("No lasting story details have been recorded yet.")}
            </p>
            <.form
              :if={@memory_editor}
              for={%{}}
              as={:memory}
              id="story-memory-form"
              phx-change="change-story-memory-form"
              phx-submit="save-story-memory"
              class="mt-4 space-y-3 rounded-xl border border-violet-700 bg-violet-950/40 p-3"
            >
              <input
                type="hidden"
                name="memory[expected_revision]"
                value={@correction_options.revision}
              />
              <input type="hidden" name="memory[submit]" value={@memory_submit} />
              <h3 class="text-sm font-semibold text-stone-100">
                {if @memory_editor == :new,
                  do: gettext("Keep a story detail"),
                  else: gettext("Edit this story detail")}
              </h3>
              <div>
                <label for="memory-kind" class="block text-sm font-medium text-stone-200">
                  {gettext("Kind")}
                </label>
                <select
                  id="memory-kind"
                  name="memory[kind]"
                  class="mt-1 block w-full rounded-lg border-violet-800 bg-stone-950 text-sm text-stone-100 focus:border-violet-400 focus:ring-violet-400"
                >
                  <option value="fact" selected={@memory_form["kind"] == "fact"}>
                    {gettext("Fact")}
                  </option>
                  <option value="relationship" selected={@memory_form["kind"] == "relationship"}>
                    {gettext("Relationship")}
                  </option>
                  <option value="commitment" selected={@memory_form["kind"] == "commitment"}>
                    {gettext("Promise or commitment")}
                  </option>
                </select>
              </div>
              <div>
                <label for="memory-title" class="block text-sm font-medium text-stone-200">
                  {gettext("Short title")}
                </label>
                <input
                  id="memory-title"
                  name="memory[title]"
                  value={@memory_form["title"]}
                  maxlength="120"
                  required
                  class="mt-1 block w-full rounded-lg border-violet-800 bg-stone-950 text-sm text-stone-100 focus:border-violet-400 focus:ring-violet-400"
                />
              </div>
              <div>
                <label for="memory-details" class="block text-sm font-medium text-stone-200">
                  {gettext("Detail to remember")}
                </label>
                <textarea
                  id="memory-details"
                  name="memory[details]"
                  rows="3"
                  maxlength="300"
                  required
                  class="mt-1 block w-full rounded-lg border-violet-800 bg-stone-950 text-sm text-stone-100 focus:border-violet-400 focus:ring-violet-400"
                >{@memory_form["details"]}</textarea>
                <p class="mt-1 text-right text-xs text-stone-400">
                  {gettext("%{count} / 300 characters",
                    count: String.length(@memory_form["details"])
                  )}
                </p>
              </div>
              <div>
                <label for="memory-reason" class="block text-sm font-medium text-stone-200">
                  {gettext("Why should this stay in the campaign record?")}
                </label>
                <textarea
                  id="memory-reason"
                  name="memory[reason]"
                  rows="2"
                  maxlength="1000"
                  required
                  class="mt-1 block w-full rounded-lg border-violet-800 bg-stone-950 text-sm text-stone-100 focus:border-violet-400 focus:ring-violet-400"
                >{@memory_form["reason"]}</textarea>
              </div>
              <p :if={@memory_error} role="alert" class="text-sm font-medium text-rose-700">
                {@memory_error}
              </p>
              <div class="flex flex-wrap items-center gap-2">
                <button
                  type="submit"
                  disabled={blocking_turn?(@current_turn)}
                  phx-disable-with={
                    if @memory_submit == "retract",
                      do: gettext("Removing…"),
                      else: gettext("Saving…")
                  }
                  class="rounded-full bg-violet-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {if @memory_submit == "retract",
                    do: gettext("Remove memory"),
                    else: gettext("Save memory")}
                </button>
                <button
                  :if={@memory_editor != :new and @memory_submit == "save"}
                  type="button"
                  phx-click="set-story-memory-action"
                  phx-value-action="retract"
                  class="rounded-full border border-rose-700 px-3 py-2 text-sm font-medium text-rose-200 hover:bg-rose-950/60 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {gettext("Remove from active memory")}
                </button>
                <button
                  :if={@memory_editor != :new and @memory_submit == "retract"}
                  type="button"
                  phx-click="set-story-memory-action"
                  phx-value-action="save"
                  class="rounded-full px-3 py-2 text-sm font-medium text-stone-300 hover:bg-stone-800"
                >
                  {gettext("Keep editing")}
                </button>
                <button
                  type="button"
                  phx-click="cancel-story-memory"
                  class="rounded-full px-3 py-2 text-sm font-medium text-stone-300 hover:bg-stone-800"
                >
                  {gettext("Cancel")}
                </button>
              </div>
              <p :if={@memory_submit == "retract"} class="text-xs leading-5 text-stone-400">
                {gettext(
                  "Removing a note hides it from the board and future GM context; its audit history remains."
                )}
              </p>
              <p :if={@memory_submit == "save"} class="text-xs leading-5 text-stone-400">
                {gettext(
                  "Saved outside the story timeline. It will guide relevant future scenes."
                )}
              </p>
            </.form>
          </details>
        </section>

        <details
          id="campaign-objectives"
          hidden={!@campaign_reference_open?}
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Campaign commitments updated")}
          tabindex="-1"
          class="scroll-mt-20 rounded-2xl border border-amber-200 bg-amber-50/50 p-4 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <summary class="cursor-pointer list-none rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
            <span class="flex items-center justify-between gap-3">
              <span>
                <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
                  {gettext("Campaign commitments")}
                </span>
                <span
                  role="heading"
                  aria-level="2"
                  class="mt-0.5 block text-base font-semibold text-stone-950"
                >
                  {gettext("Objectives")}
                </span>
              </span>
              <span
                data-panel-watch="objective-count"
                class="shrink-0 rounded-full bg-white/80 px-2 py-1 text-xs font-semibold text-stone-700"
              >
                {length(@projection.objectives)}
              </span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-6 text-stone-600">
            {gettext("Projects, quests, and leads that carry forward between sessions.")}
          </p>
          <div :if={@projection.objectives != []} class="mt-3 space-y-3">
            <section
              :for={status <- [:open, :completed, :abandoned]}
              :if={objectives_for_status(@projection.objectives, status) != []}
              class="border-t border-amber-200/70 pt-3 first:border-0 first:pt-0"
            >
              <h3 class="text-xs font-semibold uppercase tracking-wide text-stone-500">
                {objective_status_label(status)}
              </h3>
              <ul class="mt-2 space-y-2">
                <li
                  :for={objective <- objectives_for_status(@projection.objectives, status)}
                  id={"objective-#{objective.objective_id}"}
                  data-panel-watch={"objective-#{objective.objective_id}"}
                  data-panel-watch-state={objective.status}
                  class="rounded-xl bg-white/80 px-3 py-3"
                >
                  <h4 class="font-semibold text-stone-900">{objective.title}</h4>
                  <p
                    :if={objective.details}
                    class="mt-1 whitespace-pre-wrap text-sm leading-6 text-stone-700"
                  >
                    {objective.details}
                  </p>
                  <a
                    :if={
                      playable?(@session) and not is_nil(@correction_options) and
                        not blocking_turn?(@current_turn)
                    }
                    id={"correct-objective-#{objective.objective_id}"}
                    href="#canon-corrections"
                    phx-click="start-canon-correction"
                    phx-value-kind="objective"
                    phx-value-target-id={objective.objective_id}
                    class="mt-2 inline-flex min-h-8 items-center rounded px-2 py-1 text-xs font-semibold text-amber-900 underline decoration-amber-700/40 underline-offset-2 hover:bg-amber-100"
                  >
                    {gettext("Correct")}<span class="sr-only">: {objective.title}</span>
                  </a>
                </li>
              </ul>
            </section>
          </div>
          <p :if={@projection.objectives == []} class="mt-3 text-sm leading-6 text-stone-500">
            {gettext("No campaign objectives have been recorded yet.")}
          </p>
        </details>

        <section
          id="current-place"
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Current scene updated")}
          tabindex="-1"
          class="scroll-mt-20 rounded-2xl border border-amber-200 bg-amber-50/60 p-5 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
            {gettext("The scene")}
          </p>
          <h2
            :if={@player_character && @player_character.current_place}
            data-panel-watch="current-place"
            class="mt-1 text-lg font-semibold text-stone-950"
          >
            {@player_character.current_place.name}
          </h2>
          <div :if={@projection.nearby_places != []} id="nearby-places" class="mt-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">
              {gettext("Nearby routes")}
            </p>
            <ul class="mt-1 space-y-1">
              <li
                :for={place <- Enum.take(@projection.nearby_places, 3)}
                id={"nearby-place-#{place.place_id}"}
                data-panel-watch={"nearby-place-#{place.place_id}"}
                class="flex items-center justify-between gap-3 text-sm"
              >
                <span class="font-medium text-stone-800">{place.name}</span>
                <span class="shrink-0 text-stone-600">
                  {gettext("Travel time: %{minutes} min", minutes: place.travel_minutes)}
                </span>
              </li>
            </ul>
            <details :if={length(@projection.nearby_places) > 3} class="mt-1">
              <summary class="cursor-pointer text-xs font-semibold text-amber-900">
                {gettext("See %{count} more", count: length(@projection.nearby_places) - 3)}
              </summary>
              <ul class="mt-1 space-y-1">
                <li
                  :for={place <- Enum.drop(@projection.nearby_places, 3)}
                  id={"nearby-place-#{place.place_id}"}
                  data-panel-watch={"nearby-place-#{place.place_id}"}
                  class="flex items-center justify-between gap-3 text-sm"
                >
                  <span class="font-medium text-stone-800">{place.name}</span>
                  <span class="shrink-0 text-stone-600">
                    {gettext("Travel time: %{minutes} min", minutes: place.travel_minutes)}
                  </span>
                </li>
              </ul>
            </details>
          </div>
          <.canonical_change_receipt
            :if={
              @player_character && @player_character.current_place &&
                Map.has_key?(
                  @projection.latest_place_changes,
                  @player_character.current_place.place_id
                )
            }
            id={"place-change-#{@player_character.current_place && @player_character.current_place.place_id}"}
            change={
              Map.get(
                @projection.latest_place_changes,
                @player_character && @player_character.current_place &&
                  @player_character.current_place.place_id
              )
            }
          />
          <p
            :if={!@player_character || !@player_character.current_place}
            class="mt-2 text-sm leading-6 text-stone-600"
          >
            {gettext("Your current place has not been recorded yet.")}
          </p>
          <div class="mt-3 rounded-xl border border-amber-200/70 bg-white/70 px-3 py-3">
            <p
              id="current-situation-label"
              class="text-xs font-semibold uppercase tracking-wide text-stone-500"
            >
              {gettext("Current situation")}
            </p>
            <p
              id="current-situation"
              data-panel-watch="current-situation"
              class="mt-1 whitespace-pre-wrap text-sm leading-6 text-stone-800"
            >
              {@current_situation || gettext("No current situation has been recorded yet.")}
            </p>
          </div>
          <div
            :if={characters_here(@projection.characters, @player_character) != []}
            id="scene-companions"
            class="mt-3 border-t border-amber-200/70 pt-3"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">
              {gettext("Here with you")}
            </p>
            <ul id="scene-companions-at-a-glance" class="mt-2 space-y-1.5">
              <li
                :for={
                  character <-
                    Enum.take(characters_here(@projection.characters, @player_character), 3)
                }
                id={"scene-companion-#{character.speaker_id}"}
                data-panel-watch={"scene-companion-#{character.speaker_id}"}
                class="rounded-lg bg-white/80 px-3 py-2"
              >
                <p class="text-sm font-semibold text-stone-900">{character.name}</p>
                <p
                  :if={character.visible_activity}
                  class="mt-0.5 line-clamp-2 text-sm leading-5 text-stone-600"
                >
                  {character.visible_activity}
                </p>
              </li>
            </ul>
            <details
              :if={length(characters_here(@projection.characters, @player_character)) > 3}
              id="scene-companions-overflow"
              class="mt-1"
            >
              <summary class="cursor-pointer text-xs font-semibold text-amber-900">
                {gettext("See %{count} more",
                  count: length(characters_here(@projection.characters, @player_character)) - 3
                )}
              </summary>
              <ul id="scene-companions-overflow-list" class="mt-2 space-y-1.5">
                <li
                  :for={
                    character <-
                      Enum.drop(characters_here(@projection.characters, @player_character), 3)
                  }
                  id={"scene-companion-#{character.speaker_id}"}
                  data-panel-watch={"scene-companion-#{character.speaker_id}"}
                  class="rounded-lg bg-white/80 px-3 py-2"
                >
                  <p class="text-sm font-semibold text-stone-900">{character.name}</p>
                  <p
                    :if={character.visible_activity}
                    class="mt-0.5 line-clamp-2 text-sm leading-5 text-stone-600"
                  >
                    {character.visible_activity}
                  </p>
                </li>
              </ul>
            </details>
          </div>
          <details
            :if={@player_character && @player_character.current_place}
            id="scene-details"
            class="mt-2 border-t border-amber-200/70 pt-2"
          >
            <summary class="cursor-pointer rounded font-semibold text-sm text-stone-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
              {gettext("Place details")}
            </summary>
            <div class="mt-2">
              <p
                :if={@player_character.current_place.description}
                class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-700"
              >
                {@player_character.current_place.description}
              </p>
              <dl
                :if={map_size(@player_character.current_place.facts) > 0}
                class="mt-3 space-y-2 border-t border-amber-200/70 pt-3"
              >
                <div
                  :for={{key, value} <- @player_character.current_place.facts}
                  data-panel-watch={"place-fact-#{key}"}
                >
                  <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">
                    {world_label(key)}
                  </dt>
                  <dd class="mt-0.5 whitespace-pre-wrap text-sm leading-6 text-stone-800">
                    {display_value(value)}
                  </dd>
                </div>
              </dl>
            </div>
          </details>
        </section>

        <section
          :if={@player_character}
          id="player-character-at-a-glance"
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Character details updated")}
          tabindex="-1"
          class="play-sidebar-section scroll-mt-20 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
            {gettext("Your character")}
          </p>
          <h2
            id="player-character-name"
            data-panel-watch="player-character-name"
            class="mt-0.5 text-base font-semibold text-stone-950"
          >
            {@player_character.name}
          </h2>
          <p
            :if={player_character_description(@player_character)}
            id="player-character-description"
            data-panel-watch="player-character-description"
            class="mt-2 whitespace-pre-wrap text-sm leading-6 text-stone-700"
          >
            {player_character_description(@player_character)}
          </p>
          <dl
            :if={player_character_profile_summary(@player_character) != []}
            class="mt-3 grid gap-2 border-t border-stone-100 pt-3 sm:grid-cols-2"
          >
            <div
              :for={{key, value} <- player_character_profile_summary(@player_character)}
              data-panel-watch={"player-character-fact-#{key}"}
              class="min-w-0"
            >
              <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">
                {world_label(key)}
              </dt>
              <dd class="mt-0.5 whitespace-pre-wrap text-sm leading-5 text-stone-800">
                {display_value(value)}
              </dd>
            </div>
          </dl>
          <details
            :if={player_character_additional_details(@player_character) != []}
            class="mt-3 border-t border-stone-100 pt-2"
          >
            <summary class="cursor-pointer text-sm font-semibold text-amber-900">
              {gettext("See %{count} more",
                count: length(player_character_additional_details(@player_character))
              )}
            </summary>
            <dl class="mt-2 grid gap-2 sm:grid-cols-2">
              <div
                :for={{key, value} <- player_character_additional_details(@player_character)}
                class="min-w-0"
              >
                <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">
                  {world_label(key)}
                </dt>
                <dd class="mt-0.5 whitespace-pre-wrap text-sm leading-5 text-stone-800">
                  {display_value(value)}
                </dd>
              </div>
            </dl>
          </details>
        </section>

        <section
          id="character-inventory"
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Inventory updated")}
          tabindex="-1"
          class="play-sidebar-section scroll-mt-20 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
                {gettext("Your character")}
              </p>
              <h2 class="mt-0.5 text-base font-semibold text-stone-950">
                {gettext("Inventory")}
              </h2>
            </div>
            <span
              data-panel-watch="inventory-count"
              class="shrink-0 rounded-full bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700"
            >
              {length(@projection.inventory)}
            </span>
          </div>
          <ul
            :if={@projection.inventory != []}
            id="inventory-at-a-glance"
            class="mt-2 space-y-2"
          >
            <.inventory_item
              :for={item <- Enum.take(@projection.inventory, 2)}
              item={item}
              change={Map.get(@projection.latest_inventory_changes, item["id"])}
              characters_by_id={@characters_by_id}
              playable={playable?(@session)}
              turn_blocked={blocking_turn?(@current_turn)}
              can_correct={not is_nil(@correction_options) and not blocking_turn?(@current_turn)}
            />
          </ul>
          <details
            :if={length(@projection.inventory) > 2}
            id="inventory-additional"
            class="mt-2 border-t border-stone-200 pt-2"
          >
            <summary class="cursor-pointer rounded text-sm font-semibold text-amber-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
              {gettext("See %{count} more", count: length(@projection.inventory) - 2)}
            </summary>
            <ul id="inventory-additional-list" class="mt-2 space-y-2">
              <.inventory_item
                :for={item <- Enum.drop(@projection.inventory, 2)}
                item={item}
                change={Map.get(@projection.latest_inventory_changes, item["id"])}
                characters_by_id={@characters_by_id}
                playable={playable?(@session)}
                turn_blocked={blocking_turn?(@current_turn)}
                can_correct={
                  not is_nil(@correction_options) and not blocking_turn?(@current_turn)
                }
              />
            </ul>
          </details>
          <p :if={@projection.inventory == []} class="mt-3 text-sm leading-6 text-stone-500">
            {gettext("Nothing is being carried yet.")}
          </p>
        </section>

        <section
          id="campaign-tools"
          class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <button
            type="button"
            phx-click="toggle-campaign-tools"
            aria-expanded={to_string(@campaign_tools_open?)}
            aria-controls="canon-corrections campaign-characters"
            class="w-full cursor-pointer rounded-lg text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
          >
            <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
              {gettext("Campaign care")} · {gettext("Characters")}
            </span>
            <span class="mt-0.5 block text-sm font-semibold text-stone-800">
              {gettext("Correct tracked state")} · {length(@projection.characters)}
            </span>
          </button>
        </section>
        <details
          :if={playable?(@session) && @correction_options}
          id="canon-corrections"
          hidden={!@campaign_tools_open?}
          open={@correction_open?}
          class="play-sidebar-section rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <summary
            phx-click="toggle-canon-corrections"
            class="cursor-pointer list-none rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
          >
            <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
              {gettext("Campaign care")}
            </span>
            <span class="mt-0.5 block text-base font-semibold text-stone-950">
              {gettext("Correct tracked state")}
            </span>
          </summary>
          <p class="mt-2 text-sm leading-5 text-stone-600">
            {gettext(
              "Fix a tracked detail out of character. The correction is audited and does not add to the story or move game time."
            )}
          </p>
          <.form
            for={%{}}
            as={:correction}
            id="canon-correction-form"
            phx-change="change-correction-form"
            phx-submit="save-canon-correction"
            class="mt-4 space-y-3 border-t border-stone-100 pt-4"
          >
            <input
              type="hidden"
              name="correction[expected_revision]"
              value={@correction_options.revision}
            />
            <div>
              <label for="correction-kind" class="block text-sm font-medium text-stone-800">
                {gettext("What needs correcting?")}
              </label>
              <select
                id="correction-kind"
                name="correction[kind]"
                class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
              >
                <option value="inventory" selected={@correction_form["kind"] == "inventory"}>
                  {gettext("Inventory")}
                </option>
                <option value="resource" selected={@correction_form["kind"] == "resource"}>
                  {gettext("Tracked resource")}
                </option>
                <option value="location" selected={@correction_form["kind"] == "location"}>
                  {gettext("Character location")}
                </option>
                <option value="place" selected={@correction_form["kind"] == "place"}>
                  {gettext("Place details")}
                </option>
                <option
                  value="travel_connection"
                  selected={@correction_form["kind"] == "travel_connection"}
                >
                  {gettext("Travel route")}
                </option>
                <option value="world" selected={@correction_form["kind"] == "world"}>
                  {gettext("World state")}
                </option>
                <option value="objective" selected={@correction_form["kind"] == "objective"}>
                  {gettext("Campaign objective")}
                </option>
              </select>
            </div>

            <div :if={@correction_form["kind"] == "objective"} class="space-y-3">
              <div>
                <label
                  for="correction-objective-target"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Objective to correct")}
                </label>
                <select
                  id="correction-objective-target"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a public objective")}
                  </option>
                  <option
                    :for={objective <- @correction_options.objectives}
                    value={objective.objective_id}
                    selected={@correction_form["target_id"] == objective.objective_id}
                  >
                    {objective.title}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["target_id"]} class="space-y-3">
                <div>
                  <label
                    for="correction-objective-title"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Objective title")}
                  </label>
                  <input
                    id="correction-objective-title"
                    name="correction[title]"
                    value={@correction_form["title"]}
                    maxlength="160"
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-objective-details"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Objective details")}
                  </label>
                  <textarea
                    id="correction-objective-details"
                    name="correction[details]"
                    rows="3"
                    maxlength="2000"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["details"]}</textarea>
                </div>
                <div>
                  <label
                    for="correction-objective-status"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Objective status")}
                  </label>
                  <select
                    id="correction-objective-status"
                    name="correction[status]"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >
                    <option value="open" selected={@correction_form["status"] == "open"}>
                      {objective_status_label(:open)}
                    </option>
                    <option value="completed" selected={@correction_form["status"] == "completed"}>
                      {objective_status_label(:completed)}
                    </option>
                    <option value="abandoned" selected={@correction_form["status"] == "abandoned"}>
                      {objective_status_label(:abandoned)}
                    </option>
                  </select>
                </div>
              </div>
            </div>

            <div :if={@correction_form["kind"] == "world"} class="space-y-3">
              <div>
                <label
                  for="correction-world-field"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("World detail")}
                </label>
                <select
                  id="correction-world-field"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a world detail")}
                  </option>
                  <option
                    :for={field <- @correction_options.world_labels}
                    value={field.key}
                    selected={@correction_form["target_id"] == field.key}
                  >
                    {world_correction_label(field.key)}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["target_id"]}>
                <label
                  for="correction-world-value"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Correct value")}
                </label>
                <input
                  id="correction-world-value"
                  name="correction[value]"
                  value={@correction_form["value"]}
                  maxlength="300"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                />
              </div>
            </div>

            <div :if={@correction_form["kind"] == "place"} class="space-y-3">
              <div>
                <label
                  for="correction-place-details-target"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Place")}
                </label>
                <select
                  id="correction-place-details-target"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a known place")}
                  </option>
                  <option
                    :for={place <- @correction_options.places}
                    value={place.id}
                    selected={@correction_form["target_id"] == place.id}
                  >
                    {place.name}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["target_id"]} class="space-y-3">
                <div>
                  <label
                    for="correction-place-name"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Place name")}
                  </label>
                  <input
                    id="correction-place-name"
                    name="correction[name]"
                    value={@correction_form["name"]}
                    maxlength="300"
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-place-description"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Description")}
                  </label>
                  <textarea
                    id="correction-place-description"
                    name="correction[description]"
                    rows="3"
                    maxlength="10000"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["description"]}</textarea>
                </div>
                <div>
                  <label
                    for="correction-place-facts"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Known facts (JSON object)")}
                  </label>
                  <textarea
                    id="correction-place-facts"
                    name="correction[facts]"
                    rows="4"
                    maxlength="10000"
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 font-mono text-xs focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["facts"]}</textarea>
                  <p class="mt-1 text-xs leading-5 text-stone-500">
                    {gettext("Enter the complete facts object. Use {} to clear it.")}
                  </p>
                </div>
              </div>
            </div>

            <div :if={@correction_form["kind"] == "travel_connection"} class="space-y-3">
              <div>
                <label
                  for="correction-travel-route"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Travel route")}
                </label>
                <select
                  id="correction-travel-route"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a known route")}
                  </option>
                  <option
                    :for={route <- @correction_options.travel_connections}
                    value={route.id}
                    selected={@correction_form["target_id"] == route.id}
                  >
                    {route.place_a_name} ↔ {route.place_b_name}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["target_id"]} class="space-y-3">
                <div>
                  <label
                    for="correction-travel-minutes"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Travel time in minutes")}
                  </label>
                  <input
                    id="correction-travel-minutes"
                    name="correction[travel_minutes]"
                    type="number"
                    min="1"
                    max="10080"
                    value={@correction_form["travel_minutes"]}
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-travel-relevance"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Travel context")}
                  </label>
                  <textarea
                    id="correction-travel-relevance"
                    name="correction[scene_relevance]"
                    rows="3"
                    maxlength="1000"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["scene_relevance"]}</textarea>
                </div>
              </div>
            </div>

            <div :if={@correction_form["kind"] == "inventory"} class="space-y-3">
              <div>
                <label
                  for="correction-inventory-action"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Inventory change")}
                </label>
                <select
                  id="correction-inventory-action"
                  name="correction[action]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="add" selected={@correction_form["action"] == "add"}>
                    {gettext("Add a missing item")}
                  </option>
                  <option value="set" selected={@correction_form["action"] == "set"}>
                    {gettext("Correct quantity or owner")}
                  </option>
                  <option value="edit" selected={@correction_form["action"] == "edit"}>
                    {gettext("Edit item details")}
                  </option>
                  <option value="remove" selected={@correction_form["action"] == "remove"}>
                    {gettext("Remove an item that is not there")}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["action"] in ["set", "edit", "remove"]}>
                <label for="correction-item" class="block text-sm font-medium text-stone-800">
                  {gettext("Item")}
                </label>
                <select
                  id="correction-item"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose an item")}
                  </option>
                  <option
                    :for={item <- @correction_options.inventory}
                    value={item.id}
                    selected={@correction_form["target_id"] == item.id}
                  >
                    {inventory_correction_label(item)}
                  </option>
                </select>
              </div>
              <div :if={@correction_form["action"] == "edit"} class="grid gap-3 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <label
                    for="correction-item-edit-name"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Item name")}
                  </label>
                  <input
                    id="correction-item-edit-name"
                    name="correction[name]"
                    value={@correction_form["name"]}
                    maxlength="160"
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-edit-quantity"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Corrected quantity")}
                  </label>
                  <input
                    id="correction-item-edit-quantity"
                    name="correction[quantity]"
                    type="number"
                    min="1"
                    max="1000000"
                    value={@correction_form["quantity"]}
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-edit-unit"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Unit, if useful")}
                  </label>
                  <input
                    id="correction-item-edit-unit"
                    name="correction[unit]"
                    value={@correction_form["unit"]}
                    maxlength="80"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-edit-category"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Category")}
                  </label>
                  <input
                    id="correction-item-edit-category"
                    name="correction[category]"
                    value={@correction_form["category"]}
                    maxlength="100"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-edit-owner"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Held by")}
                  </label>
                  <select
                    id="correction-item-edit-owner"
                    name="correction[owner_id]"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >
                    <option
                      :for={owner <- @correction_options.owners}
                      value={owner.id}
                      selected={@correction_form["owner_id"] == owner.id}
                    >
                      {correction_owner_label(owner)}
                    </option>
                  </select>
                </div>
                <div class="sm:col-span-2">
                  <label
                    for="correction-item-edit-description"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Description")}
                  </label>
                  <textarea
                    id="correction-item-edit-description"
                    name="correction[description]"
                    rows="2"
                    maxlength="2000"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["description"]}</textarea>
                </div>
                <div class="sm:col-span-2">
                  <label
                    for="correction-item-edit-properties"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Properties (JSON object)")}
                  </label>
                  <textarea
                    id="correction-item-edit-properties"
                    name="correction[properties]"
                    rows="4"
                    maxlength="10000"
                    required
                    class="mt-1 block w-full rounded-lg border-stone-300 font-mono text-xs focus:border-amber-700 focus:ring-amber-700"
                  >{@correction_form["properties"]}</textarea>
                  <p class="mt-1 text-xs leading-5 text-stone-500">
                    {gettext("Enter the complete properties object. Use {} to clear it.")}
                  </p>
                </div>
              </div>
              <div :if={@correction_form["action"] == "add"} class="grid gap-3 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <label
                    for="correction-item-name"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Item name")}
                  </label>
                  <input
                    id="correction-item-name"
                    name="correction[name]"
                    value={@correction_form["name"]}
                    maxlength="160"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-quantity"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Quantity")}
                  </label>
                  <input
                    id="correction-item-quantity"
                    name="correction[quantity]"
                    type="number"
                    min="1"
                    max="1000000"
                    value={@correction_form["quantity"]}
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-unit"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Unit, if useful")}
                  </label>
                  <input
                    id="correction-item-unit"
                    name="correction[unit]"
                    value={@correction_form["unit"]}
                    maxlength="80"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div class="sm:col-span-2">
                  <label
                    for="correction-item-owner"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Held by")}
                  </label>
                  <select
                    id="correction-item-owner"
                    name="correction[owner_id]"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >
                    <option
                      :for={owner <- @correction_options.owners}
                      value={owner.id}
                      selected={@correction_form["owner_id"] == owner.id}
                    >
                      {correction_owner_label(owner)}
                    </option>
                  </select>
                </div>
              </div>
              <div
                :if={
                  @correction_form["kind"] == "inventory" && @correction_form["action"] == "set"
                }
                class="space-y-3"
              >
                <div>
                  <label
                    for="correction-item-set-quantity"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Corrected quantity (zero removes it)")}
                  </label>
                  <input
                    id="correction-item-set-quantity"
                    name="correction[quantity]"
                    type="number"
                    min="0"
                    max="1000000"
                    value={@correction_form["quantity"]}
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  />
                </div>
                <div>
                  <label
                    for="correction-item-set-owner"
                    class="block text-sm font-medium text-stone-800"
                  >
                    {gettext("Correct owner, if needed")}
                  </label>
                  <select
                    id="correction-item-set-owner"
                    name="correction[owner_id]"
                    class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                  >
                    <option value="">{gettext("Keep current owner")}</option>
                    <option :for={owner <- @correction_options.owners} value={owner.id}>
                      {correction_owner_label(owner)}
                    </option>
                  </select>
                </div>
              </div>
              <p :if={@correction_form["action"] == "remove"} class="text-sm text-amber-900">
                {gettext("This removes the selected item from tracked inventory immediately.")}
              </p>
            </div>

            <div :if={@correction_form["kind"] == "resource"} class="space-y-3">
              <div>
                <label for="correction-resource" class="block text-sm font-medium text-stone-800">
                  {gettext("Tracked detail")}
                </label>
                <select
                  id="correction-resource"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a tracked detail")}
                  </option>
                  <option
                    :for={field <- @correction_options.resources}
                    value={field.key}
                    selected={@correction_form["target_id"] == field.key}
                  >
                    {resource_correction_label(field)}
                  </option>
                </select>
              </div>
              <div>
                <label
                  for="correction-resource-value"
                  class="block text-sm font-medium text-stone-800"
                >
                  {gettext("Correct value")}
                </label>
                <input
                  id="correction-resource-value"
                  name="correction[value]"
                  value={@correction_form["value"]}
                  inputmode={
                    correction_inputmode(
                      @correction_form["target_id"],
                      @correction_options.resources
                    )
                  }
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                />
              </div>
            </div>

            <div :if={@correction_form["kind"] == "location"} class="space-y-3">
              <div>
                <label for="correction-character" class="block text-sm font-medium text-stone-800">
                  {gettext("Character")}
                </label>
                <select
                  id="correction-character"
                  name="correction[target_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["target_id"])}>
                    {gettext("Choose a character")}
                  </option>
                  <option
                    :for={character <- @correction_options.characters}
                    value={character.id}
                    selected={@correction_form["target_id"] == character.id}
                  >
                    {character.name}
                  </option>
                </select>
              </div>
              <div>
                <label for="correction-place" class="block text-sm font-medium text-stone-800">
                  {gettext("Correct location")}
                </label>
                <select
                  id="correction-place"
                  name="correction[place_id]"
                  class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
                >
                  <option value="" selected={is_nil(@correction_form["place_id"])}>
                    {gettext("Choose a known place")}
                  </option>
                  <option
                    :for={place <- @correction_options.places}
                    value={place.id}
                    selected={@correction_form["place_id"] == place.id}
                  >
                    {place.name}
                  </option>
                </select>
              </div>
            </div>

            <div>
              <label for="correction-reason" class="block text-sm font-medium text-stone-800">
                {gettext("Reason")}
              </label>
              <textarea
                id="correction-reason"
                name="correction[reason]"
                rows="2"
                maxlength="1000"
                required
                class="mt-1 block w-full rounded-lg border-stone-300 text-sm focus:border-amber-700 focus:ring-amber-700"
              >{@correction_form["reason"]}</textarea>
              <p class="mt-1 text-xs leading-5 text-stone-500">
                {gettext("Saved with the audit record, outside the campaign story.")}
              </p>
            </div>
            <p :if={@correction_error} role="alert" class="text-sm font-medium text-rose-700">
              {@correction_error}
            </p>
            <button
              type="submit"
              disabled={blocking_turn?(@current_turn)}
              class="w-full rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50"
            >{gettext("Save correction")}</button>
          </.form>
          <details
            :if={@correction_receipts != []}
            id="recent-canon-corrections"
            class="mt-4 border-t border-stone-100 pt-3"
          >
            <summary class="cursor-pointer text-sm font-semibold text-stone-700">
              {gettext("Recent corrections")}
            </summary>
            <ol class="mt-2 space-y-2">
              <li :for={receipt <- @correction_receipts} class="rounded-lg bg-stone-50 px-3 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">
                  {correction_kind_label(receipt.kind)}
                </p>
                <p :if={receipt.target_label} class="mt-1 text-sm font-medium text-stone-800">
                  {receipt.target_label}
                </p>
                <p class="mt-1 text-xs leading-5 text-stone-600">
                  <span class="font-medium">{gettext("Before")}</span>
                  {correction_receipt_value(receipt.kind, receipt.before)}
                  <span class="px-1 text-stone-400">→</span>
                  <span class="font-medium">{gettext("After")}</span>
                  {correction_receipt_value(receipt.kind, receipt.after)}
                </p>
                <p class="mt-1 whitespace-pre-wrap text-sm text-stone-700">{receipt.reason}</p>
              </li>
            </ol>
          </details>
        </details>

        <details
          id="campaign-characters"
          hidden={!@campaign_tools_open?}
          phx-hook="PanelPulse"
          data-panel-change-message={gettext("Characters updated")}
          class="play-sidebar-section rounded-2xl border border-stone-200 bg-white p-4 shadow-sm"
        >
          <p
            class="sr-only"
            data-panel-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <summary class="cursor-pointer list-none rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
            <span class="flex items-center justify-between gap-3">
              <span>
                <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-amber-800">
                  {gettext("In the story")}
                </span>
                <span
                  role="heading"
                  aria-level="2"
                  class="mt-0.5 block text-base font-semibold text-stone-950"
                >
                  {gettext("Characters")}
                </span>
              </span>
              <span
                data-panel-watch="character-count"
                class="shrink-0 rounded-full bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700"
              >
                {length(@projection.characters)}
              </span>
            </span>
          </summary>
          <ul class="mt-3 space-y-3">
            <li
              :for={character <- @projection.characters}
              data-panel-watch={"character-#{character.speaker_id}"}
              class="border-t border-stone-100 pt-2 first:border-0 first:pt-0"
            >
              <h3 class="font-semibold text-stone-900">{character.name}</h3>
              <p :if={character.role == :player} class="mt-0.5 text-xs text-stone-500">
                {gettext("Your character")}
              </p>
              <p class="mt-1 text-xs text-stone-500">
                {character_location_label(character, @player_character)}
              </p>
              <.canonical_change_receipt
                :if={Map.has_key?(@projection.latest_character_changes, character.speaker_id)}
                id={"character-change-#{character.speaker_id}"}
                change={Map.fetch!(@projection.latest_character_changes, character.speaker_id)}
              />
              <p :if={character.visible_activity} class="mt-1 text-sm leading-5 text-stone-700">
                {character.visible_activity}
              </p>
              <details
                :if={map_size(character.visible_facts) > 0}
                class="mt-2 text-sm text-stone-600"
              >
                <summary class="cursor-pointer font-medium">{gettext("Known details")}</summary>
                <dl class="mt-2 space-y-2 pl-3">
                  <div :for={{key, value} <- character.visible_facts}>
                    <dt class="font-medium text-stone-700">{world_label(key)}</dt>
                    <dd class="whitespace-pre-wrap">{display_value(value)}</dd>
                  </div>
                </dl>
              </details>
            </li>
          </ul>
        </details>
      </aside>
    </div>
  </div>
</section>
