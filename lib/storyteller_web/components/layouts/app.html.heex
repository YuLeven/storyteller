<header class="tabletop-header border-b border-stone-200 bg-white/90 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 py-4">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-4">
      <.link
        navigate={~p"/"}
        class="tabletop-brand text-lg font-semibold tracking-tight text-stone-900"
      >Storyteller</.link>
    </div>
    <details id="app-settings" class="relative self-start">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-stone-300 hover:bg-stone-800/60 hover:text-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">
        <svg
          aria-hidden="true"
          class="h-4 w-4 text-amber-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 8.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5Z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m19.4 15 .05.04a1.85 1.85 0 0 1-2.62 2.62l-.04-.05a1.83 1.83 0 0 0-3.12 1.3v.14a1.85 1.85 0 0 1-3.7 0v-.07a1.83 1.83 0 0 0-3.12-1.3l-.05.05a1.85 1.85 0 0 1-2.61-2.62l.04-.04a1.83 1.83 0 0 0-1.3-3.12H2.8a1.85 1.85 0 0 1 0-3.7h.07a1.83 1.83 0 0 0 1.3-3.12l-.05-.05a1.85 1.85 0 0 1 2.62-2.61l.04.04a1.83 1.83 0 0 0 3.12-1.3V3a1.85 1.85 0 0 1 3.7 0v.07a1.83 1.83 0 0 0 3.12 1.3l.05-.05a1.85 1.85 0 0 1 2.61 2.62l-.04.04a1.83 1.83 0 0 0 1.3 3.12h.07a1.85 1.85 0 0 1 0 3.7h-.07a1.83 1.83 0 0 0-1.3 1.3Z"
          />
        </svg>
        {gettext("Settings")}
      </summary>
      <div class="absolute right-0 z-40 mt-2 w-72 rounded-xl border border-stone-500 bg-white p-4 shadow-2xl">
        <p class="mb-3 text-sm font-semibold text-stone-900">{gettext("Interface language")}</p>
        <.form for={%{}} action={~p"/locale"} method="post" class="flex items-end gap-2">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <label for="ui-locale" class="sr-only">{gettext("Interface language")}</label>
          <select
            id="ui-locale"
            name="locale"
            class="min-w-0 flex-1 rounded-lg border-stone-300 py-2 text-sm shadow-sm focus:border-amber-700 focus:ring-amber-700"
          >
            <option value="en" selected={@ui_locale == "en"}>English</option>
            <option value="es" selected={@ui_locale == "es"}>Español</option>
            <option value="fr" selected={@ui_locale == "fr"}>Français</option>
          </select>
          <button
            type="submit"
            class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
          >{gettext("Apply")}</button>
        </.form>
      </div>
    </details>
  </div>
</header>
<main class="tabletop-main min-h-[calc(100vh-4rem)] px-4 py-10 sm:px-6 lg:px-8 sm:py-14">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
