<div class="mx-auto max-w-3xl space-y-8">
  <header class="space-y-3">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-emerald-700">
      {gettext("Account access")}
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-stone-950">
      {gettext("Connect ChatGPT")}
    </h1>
    <p class="max-w-2xl text-stone-600">
      {gettext(
        "Storyteller uses the public Responses API with permission from your ChatGPT account. Campaign history stays in this local app."
      )}
    </p>
  </header>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-stone-900">{gettext("Connection status")}</h2>
    <%= if @status.connected? do %>
      <p class="mt-3 text-emerald-800">{gettext("ChatGPT plan usage is connected.")}</p>
      <p
        :if={@status.plan_usage_paused?}
        class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-950"
      >
        {gettext(
          "Plan requests are paused across all sessions. Check Usage settings, then resume from a session when you believe requests are available."
        )}
      </p>
      <%= if @status.account_email do %>
        <p class="mt-1 text-sm text-stone-600">
          {gettext("Account:")} <span class="font-medium">{@status.account_email}</span>
        </p>
      <% end %>
      <p class="mt-2 text-sm">
        <a
          class="font-medium text-emerald-900 underline underline-offset-2 hover:text-emerald-700"
          href="https://chatgpt.com/settings/usage"
          target="_blank"
          rel="noreferrer"
        >{gettext("Manage usage")}</a>
      </p>
      <.form for={%{}} action={~p"/auth/authorize"} method="post" class="mt-5">
        <button
          type="submit"
          class="rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800"
        >{gettext("Reconnect ChatGPT")}</button>
      </.form>
      <.form for={%{}} action={~p"/auth/disconnect"} method="post" class="mt-5">
        <button
          type="submit"
          class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50"
        >
          {gettext("Disconnect ChatGPT")}
        </button>
      </.form>
    <% else %>
      <p class="mt-3 text-stone-700">{gettext("No active ChatGPT plan connection.")}</p>
      <%= if @status.account_email do %>
        <p class="mt-1 text-sm text-stone-600">
          {gettext("Saved registration for")}
          <span class="font-medium">{@status.account_email}</span>
        </p>
      <% end %>
      <.form for={%{}} action={~p"/auth/authorize"} method="post" class="mt-5">
        <button
          type="submit"
          class="rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800"
        >
          {gettext("Continue with ChatGPT")}
        </button>
      </.form>
      <p class="mt-3 max-w-xl text-sm leading-6 text-stone-600">
        {gettext(
          "After reviewing access in ChatGPT, you’ll return here. If the preview accepts this app and account, start testing in Amber Orchard."
        )}
      </p>
    <% end %>
  </section>

  <section :if={@status.connected?} class="rounded-2xl border border-stone-200 bg-white shadow-sm">
    <details id="gm-model-setting" class="group">
      <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 px-6 py-4 font-semibold text-stone-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
        <span>{gettext("Game master model")}</span>
        <span class="text-sm font-medium text-stone-600">{@preferred_model_name}</span>
      </summary>
      <div class="border-t border-stone-200 px-6 py-5">
        <p class="text-sm leading-6 text-stone-600">
          {gettext(
            "Choose which available account model resolves new turns. Automatic keeps Storyteller's current account-catalog selection behavior."
          )}
        </p>
        <%= if @catalog_available? do %>
          <.form
            for={%{}}
            action={~p"/auth/model"}
            method="post"
            class="mt-4 flex flex-wrap items-end gap-3"
          >
            <label for="gm-model" class="sr-only">{gettext("Game master model")}</label>
            <select
              id="gm-model"
              name="model"
              class="min-w-64 flex-1 rounded-lg border-stone-300 py-2 text-sm shadow-sm focus:border-amber-700 focus:ring-amber-700"
            >
              <option value="automatic" selected={is_nil(@preferred_model)}>
                {gettext("Automatic")}
              </option>
              <option
                :for={model <- @models}
                value={model.slug}
                selected={@preferred_model == model.slug}
              >
                {model.display_name} ({model.slug})
              </option>
            </select>
            <button
              type="submit"
              class="rounded-lg bg-stone-800 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
            >{gettext("Save model")}</button>
          </.form>
          <p
            :if={@preferred_model && not Enum.any?(@models, &(&1.slug == @preferred_model))}
            class="mt-3 text-sm text-amber-800"
          >
            {gettext(
              "Your saved model is no longer listed. Choose another model or return to Automatic."
            )}
          </p>
        <% else %>
          <p role="status" class="mt-4 text-sm text-amber-800">
            {gettext(
              "The account model list is unavailable right now. Reopen this page to try again."
            )}
          </p>
        <% end %>
      </div>
    </details>
  </section>

  <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-6 text-stone-800">
    <h2 class="text-base font-semibold">{gettext("Preview eligibility and usage")}</h2>
    <p class="mt-2">
      {gettext(
        "Sign in with ChatGPT plan usage is a preview for eligible open-source, locally hosted apps. Storyteller is released under the MIT license and is intended to run on this computer at %{address}.",
        address: "127.0.0.1"
      )}
    </p>
    <p class="mt-2">
      {gettext(
        "This connection uses your ChatGPT plan allowance; it does not use an API key or API credits. Usage limits are shared with other ChatGPT apps. When ChatGPT reports a plan usage limit, Storyteller pauses game-master requests across all sessions. Check ChatGPT Usage settings, then resume from a session when you believe requests are available and retry the saved turn."
      )}
    </p>
    <p class="mt-2">
      {gettext("Review the current")}
      <a
        class="font-medium underline"
        href="https://developers.openai.com/siwc/token-sharing-open-source/preview-limitations"
        target="_blank"
        rel="noreferrer"
      >{gettext("preview limitations")}</a>
      {gettext("and confirm your app is eligible before connecting.")}
    </p>
  </section>
</div>
