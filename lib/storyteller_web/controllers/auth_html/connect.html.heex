<div class="mx-auto max-w-3xl space-y-8">
  <header class="space-y-3">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-emerald-700">Account access</p>
    <h1 class="text-3xl font-semibold tracking-tight text-stone-950">Connect ChatGPT</h1>
    <p class="max-w-2xl text-stone-600">
      Storyteller uses the public Responses API with permission from your ChatGPT account. Campaign history stays in this local app.
    </p>
  </header>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-stone-900">Connection status</h2>
    <%= if @status.connected? do %>
      <p class="mt-3 text-emerald-800">ChatGPT plan usage is connected.</p>
      <%= if @status.account_email do %>
        <p class="mt-1 text-sm text-stone-600">
          Account: <span class="font-medium">{@status.account_email}</span>
        </p>
      <% end %>
      <.form for={%{}} action={~p"/auth/disconnect"} method="post" class="mt-5">
        <button
          type="submit"
          class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50"
        >
          Disconnect ChatGPT
        </button>
      </.form>
    <% else %>
      <p class="mt-3 text-stone-700">No active ChatGPT plan connection.</p>
      <%= if @status.account_email do %>
        <p class="mt-1 text-sm text-stone-600">
          Saved registration for <span class="font-medium">{@status.account_email}</span>
        </p>
      <% end %>
      <.form for={%{}} action={~p"/auth/authorize"} method="post" class="mt-5">
        <button
          type="submit"
          class="rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800"
        >
          Continue with ChatGPT
        </button>
      </.form>
    <% end %>
  </section>

  <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-6 text-stone-800">
    <h2 class="text-base font-semibold">Preview eligibility and usage</h2>
    <p class="mt-2">
      Sign in with ChatGPT plan usage is a preview for eligible open-source, locally hosted apps. Storyteller is released under the MIT license and is intended to run on this computer at <code>127.0.0.1</code>.
    </p>
    <p class="mt-2">
      This connection uses your ChatGPT plan allowance; it does not use an API key or API credits. Usage limits are shared with other ChatGPT apps. If a limit blocks a request, Storyteller pauses play and keeps the turn available to retry.
    </p>
    <p class="mt-2">
      Review the current
      <a
        class="font-medium underline"
        href="https://developers.openai.com/siwc/token-sharing-open-source/preview-limitations"
        target="_blank"
        rel="noreferrer"
      >preview limitations</a>
      and confirm your app is eligible before connecting.
    </p>
  </section>
</div>
